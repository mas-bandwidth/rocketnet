<Project Sdk="Microsoft.NET.Sdk">

  <!-- the unit tests: a console program with no test framework, so the only
       package is the backend's own; it compiles the backend's ConnectToken.cs -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AssemblyName>rocketnet-backend-tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Backend/ConnectToken.cs" />
    <Compile Include="../Backend/BackendKeys.cs" />
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
  </ItemGroup>

</Project>
