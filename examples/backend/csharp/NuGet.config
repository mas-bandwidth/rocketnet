<?xml version="1.0" encoding="utf-8"?>
<!-- the one package source, so a build never depends on the machine's own NuGet settings -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
