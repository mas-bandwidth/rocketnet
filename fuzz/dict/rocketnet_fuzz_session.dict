# Dictionary for fuzz/rocketnet_fuzz_session.cpp: the script language's op
# bytes (op % 12) with their argument shapes, and the sizes that cross the
# packet and block boundaries (sdk/rocketnet.h, sdk/rocketnet_allocator.h).

selector_connected="\x00"
selector_handshake="\x10"

op_tick="\x00"
op_client_send="\x01"
op_server_send="\x02"
op_faulty_tick="\x03"
op_drop_c2s="\x04"
op_drop_s2c="\x05"
op_duplicate="\x06"
op_reverse="\x07"
op_corrupt="\x08"
op_garbage="\x09"
op_sealed="\x0a"
op_silence="\x0b"

# channel c carries reliability c (rocketnet_reliability_t)
channel_unreliable="\x00"
channel_reliable_ordered="\x03"
channel_ordered_receipt="\x07"

# sizes: the header, ROCKETNET_MAX_PACKET_PAYLOAD_BYTES (1416) and one past,
# RN_STORE_LARGE_BYTES (ROCKETNET_MESSAGE_FRAGMENT_BYTES, 1152) and one past,
# and ROCKETNET_FUZZ_MAX_MESSAGE_BYTES (16384)
size_header="\x08\x00"
size_packet_payload="\x88\x05"
size_packet_payload_plus_one="\x89\x05"
size_block_stride="\x80\x04"
size_block_stride_plus_one="\x81\x04"
size_max_message="\x00\x40"

# faulty tick decisions: deliver, drop, duplicate, hold
decide_deliver="\x00"
decide_drop="\x01"
decide_duplicate="\x02"
decide_hold="\x03"
