---
# The static-analysis gate. .github/workflows/static.yml runs clang-tidy over
# every sdk/*.cpp with these checks, and tools/run_static.py compares the
# findings against tools/static_baseline.txt.
#
# Three families are enabled. The disabled checks below are the short list this
# code base cannot satisfy; each carries its reason. A check is disabled only
# with a reason, never to quiet a single site -- a real finding is baselined in
# tools/static_baseline.txt and the baseline only shrinks.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  cert-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-macro-parentheses,
  -bugprone-reserved-identifier,
  -bugprone-signed-char-misuse,
  -cert-err33-c,
  -cert-err58-cpp

# Each disabled check, and why:
#
#   bugprone-easily-swappable-parameters
#       The wire and connection functions take adjacent same-typed numerics --
#       address halves, epochs, sequence numbers, byte counts. Reordering the
#       parameters to separate the types would break the published ABI.
#
#   bugprone-macro-parentheses
#       The assertion and logging macros expand to do/while statement blocks,
#       not to expressions. Wrapping them in parentheses is not valid C++.
#
#   bugprone-reserved-identifier
#       Include guards and internal helpers use a leading underscore as a
#       tree-wide naming convention; the reserved-identifier rule is broader
#       than the standard requires and flags that convention everywhere.
#
#   bugprone-signed-char-misuse
#       Wire, payload and base64 buffers are char by the byte-buffer design,
#       and the comparisons depend on char-to-int promotion deliberately.
#
#   cert-err33-c
#       Many calls intentionally discard a result -- the allocation hooks and
#       the logging path among them. The calls whose result matters test it at
#       the call site, so the blanket unchecked-return rule is wrong here.
#
#   cert-err58-cpp
#       File-scope objects with throwing constructors. The sdk's globals are
#       trivially constructible and constant-initialized, so the rule has no
#       site that can throw during static initialization.

WarningsAsErrors: ''
HeaderFilterRegex: '^(sdk|sodium)/.*'
FormatStyle: none
