@PACKAGE_INIT@
# the release label: RocketNet_VERSION is the numeric 1.0.0 find_package
# compares; the string carries the full prerelease label, equal to the
# installed header's ROCKETNET_VERSION_FULL
set(RocketNet_VERSION_STRING "@ROCKETNET_VERSION_STRING@")
set(RocketNet_VERSION_PRERELEASE "@ROCKETNET_VERSION_PRERELEASE@")
# Resolve only the dependencies used to build this package.
set(ROCKETNET_XDP @ROCKETNET_XDP@)
# Preserve the AF_XDP provider selected by the producer.
set(ROCKETNET_XDP_LEGACY_LIBBPF "@ROCKETNET_XDP_LEGACY_LIBBPF@")
# A consumer requires that provider as well as libbpf.
set(ROCKETNET_XDP_REQUIRED @ROCKETNET_XDP@)
set(ROCKETNET_USE_SYSTEM_SODIUM @ROCKETNET_USE_SYSTEM_SODIUM@)
# whether the package was built against liburing: a consumer resolves the
# same link, and a package built with it requires it
set(ROCKETNET_IO_URING @ROCKETNET_IO_URING_BUILT@)
set(ROCKETNET_IO_URING_REQUIRED @ROCKETNET_IO_URING_BUILT@)
include("${CMAKE_CURRENT_LIST_DIR}/RocketNetDependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/RocketNetTargets.cmake")
check_required_components(RocketNet)
