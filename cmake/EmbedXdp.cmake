include("${CMAKE_CURRENT_LIST_DIR}/XdpSources.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/source/server_xdp")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/source/sdk")
foreach(source IN LISTS ROCKETNET_XDP_SOURCES)
    configure_file("${SOURCE_DIR}/${source}" "${OUTPUT_DIR}/source/${source}" COPYONLY)
endforeach()
execute_process(COMMAND make
    WORKING_DIRECTORY "${OUTPUT_DIR}/source/server_xdp" RESULT_VARIABLE make_result)
if(NOT make_result EQUAL 0)
    message(FATAL_ERROR "XDP object build failed: ${make_result}")
endif()
execute_process(COMMAND "${XXD}" -i -n server_xdp_o "${OUTPUT_DIR}/source/server_xdp/server_xdp.o"
    OUTPUT_FILE "${OUTPUT_DIR}/rocketnet_server_xdp.h.tmp" RESULT_VARIABLE xxd_result)
if(NOT xxd_result EQUAL 0)
    message(FATAL_ERROR "XDP header embedding failed: ${xxd_result}")
endif()
file(READ "${OUTPUT_DIR}/rocketnet_server_xdp.h.tmp" xxd_content)
string(REPLACE "unsigned char" "static const unsigned char" xxd_content "${xxd_content}")
string(REPLACE "unsigned int" "static const unsigned int" xxd_content "${xxd_content}")
file(WRITE "${OUTPUT_DIR}/rocketnet_server_xdp.h" "${xxd_content}")
