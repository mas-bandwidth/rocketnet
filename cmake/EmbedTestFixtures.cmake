# Compiles committed test fixture files into the unit binary at build time, so
# ./bin/test reads no file at run time: writes OUTPUT, a C++ source holding
# each file's bytes and rocketnet_test_fixture(path, &bytes), the lookup
# tests/wycheproof.h declares. Run as a script (cmake -P) by the custom
# command in CMakeLists.txt, which depends on every fixture file and on this
# script, so a change to either regenerates the source and rebuilds ./bin/test.
#
# Inputs: SOURCE_DIR (the repository root), OUTPUT (the source file to write)
# and FIXTURES, the fixture paths relative to SOURCE_DIR separated by ","
# (a CMake list cannot cross the command line intact). The lookup key is
# that relative path with forward slashes, e.g.
# "tests/wycheproof/x25519_test.json".
#
# Portable CMake only: file(READ ... HEX), no xxd and no compiler, so the
# same step runs on Linux, macOS and Windows. The bytes are written sixteen
# to a line, so no source line is long, and each array carries one extra zero
# byte so an empty fixture is still a valid array; its size is stated apart.
# The output is written beside itself and renamed over it, so a failed step
# never leaves half a source.

if(NOT SOURCE_DIR OR NOT OUTPUT OR NOT FIXTURES)
    message(FATAL_ERROR "EmbedTestFixtures.cmake needs SOURCE_DIR, OUTPUT and FIXTURES")
endif()

string(REPLACE "," ";" fixture_list "${FIXTURES}")

# sixteen "0x..," bytes, then a newline
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 fixture_line_pattern)

set(fixture_arrays "")
set(fixture_entries "")
set(fixture_index 0)
foreach(fixture IN LISTS fixture_list)
    set(fixture_file "${SOURCE_DIR}/${fixture}")
    if(NOT EXISTS "${fixture_file}")
        message(FATAL_ERROR "EmbedTestFixtures.cmake: ${fixture} does not exist")
    endif()
    file(SIZE "${fixture_file}" fixture_bytes)
    file(READ "${fixture_file}" fixture_hex HEX)
    string(LENGTH "${fixture_hex}" fixture_hex_length)
    math(EXPR fixture_hex_expected "${fixture_bytes} * 2")
    if(NOT fixture_hex_length EQUAL fixture_hex_expected)
        message(FATAL_ERROR "EmbedTestFixtures.cmake: ${fixture} read ${fixture_hex_length} hex digits, expected ${fixture_hex_expected}")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," fixture_body "${fixture_hex}")
    string(REGEX REPLACE "(${fixture_line_pattern})" "\\1\n    " fixture_body "${fixture_body}")
    string(APPEND fixture_arrays
        "// ${fixture}, ${fixture_bytes} bytes\n"
        "static const unsigned char rocketnet_test_fixture_${fixture_index}[] =\n{\n    ${fixture_body}0x00\n};\n\n")
    string(APPEND fixture_entries
        "    { \"${fixture}\", rocketnet_test_fixture_${fixture_index}, ${fixture_bytes} },\n")
    math(EXPR fixture_index "${fixture_index} + 1")
endforeach()

string(CONCAT fixture_source
    "// Generated by cmake/EmbedTestFixtures.cmake at build time: the committed\n"
    "// test fixtures, compiled into the unit binary. Do not edit.\n\n"
    "#include <stddef.h>\n"
    "#include <string.h>\n\n"
    "const unsigned char * rocketnet_test_fixture( const char * path, size_t * bytes );\n\n"
    "${fixture_arrays}"
    "struct rocketnet_test_fixture_entry_t\n{\n"
    "    const char * path;\n"
    "    const unsigned char * data;\n"
    "    size_t bytes;\n"
    "};\n\n"
    "static const struct rocketnet_test_fixture_entry_t rocketnet_test_fixture_entries[] =\n{\n"
    "${fixture_entries}"
    "};\n\n"
    "const unsigned char * rocketnet_test_fixture( const char * path, size_t * bytes )\n{\n"
    "    for ( size_t i = 0; i < sizeof( rocketnet_test_fixture_entries ) / sizeof( rocketnet_test_fixture_entries[0] ); i++ )\n"
    "    {\n"
    "        if ( strcmp( rocketnet_test_fixture_entries[i].path, path ) == 0 )\n"
    "        {\n"
    "            *bytes = rocketnet_test_fixture_entries[i].bytes;\n"
    "            return rocketnet_test_fixture_entries[i].data;\n"
    "        }\n"
    "    }\n"
    "    *bytes = 0;\n"
    "    return NULL;\n"
    "}\n")

get_filename_component(fixture_output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${fixture_output_dir}")
file(WRITE "${OUTPUT}.tmp" "${fixture_source}")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
