------------------------ MODULE MCRNChannelViewSound ------------------------
EXTENDS Naturals, FiniteSets, Sequences, TLC
\* Is RNChannel's TLC view a true abstraction? TLC keeps the first state it
\* reaches for each view value and drops the rest, so a view is sound only
\* when any two reachable states with one view value agree on every
\* invariant, have the same enabled steps, and step to successors with one
\* view value. Otherwise the explored set depends on which state each worker
\* reaches first (MCRNChannelNotReceived.cfg: 8630 distinct on one run, 8634
\* on another, under LossySafetyView).
\*
\* A runs RNChannel's Next. B is, at every step, a copy of A with the
\* variables a view may drop given other values: each Link's pulse (0 or 1)
\* and send counter (0..Horizon), and rxQueue reordered across channels with
\* each channel's order kept. B's values are kept only where B's view equals
\* A's, so the product reaches every pair (A, B) of a reachable A and a state
\* B with A's view that differs from A only in those variables. SafetyView
\* keeps every other variable, so for it these B are every state with A's
\* view (reachable or not), and checking them all is sufficient for
\* soundness. LossySafetyView also merges trace with rxQueue; the B here are
\* only some of the states it merges, enough to show it is not sound.
\*
\* ViewSound holds at (A, B) when they agree on the invariants and, for each
\* labelled step of Next, the step is enabled in both or neither and taking
\* it in both gives equal views. Each label names one disjunct of Next with
\* its existential parameters bound, so with MaxDelay = 0 each label has at
\* most one successor and the per-label check is the successor-set check
\* (matching a step only by its own label is stronger than needed).
\*
\* Vary names the dropped variables B may change: "pulse", "sent", "queue".
\* LossyView = FALSE checks SafetyView with all three
\* (MCRNChannelViewSound.cfg, pass). LossyView = TRUE checks the pre-v1.1.9
\* LossySafetyView (MCRNChannelViewSoundBrokenLossy.cfg, ViewSound violated)
\* with "queue" alone: a B that differs from A in a send counter is caught in
\* the initial state, where no reachable state has that counter, while a B
\* with the same deliveries queued in another cross-channel order is a state
\* the model reaches (README-RNChannel.md reads the counterexample).
\* Generated by a throwaway program; the substitution lists are RNChannel's
\* VARIABLES.
CONSTANTS W, SendCapacity, P, MaxPid, Capacity, MaxDelay, Duplication, AckCapacity, Reordering,
          FwdPattern, RevPattern, BurstStart, BurstLen, BrokenOutOfOrder, BrokenTwice,
          BrokenDropOnRetransmit, BrokenPartialChunk, BrokenChunkBlocksSmall,
          BrokenNoSequencedReset, ProbeSequenced, AppMayLeave, BrokenSilentDrop,
          LossyView, Vary, QueuedBound

VARIABLES a_written, a_waitedForRoom, a_roomReturned, a_refused, a_uDropped, a_queued, a_admitted,
          a_acked, a_smap, a_forgotten, a_reserved, a_ordered_write, a_sequenced_write,
          a_ordered_read, a_sequenced_watermark, a_sentTrace, a_trace, a_rxQueue, a_chunks,
          a_received, a_live, a_batch, a_phase, a_pending, a_duplicateReady, a_whole, a_placed,
          a_collision, a_uSent, a_uCount, a_seen, a_probeWrite, a_probeRead, a_resetOK, a_taken,
          a_notReceived, a_misused, a_deliveredCount, a_fwdWire, a_fwdSent, a_fwdPulse, a_revWire,
          a_revSent, a_revPulse

VARIABLES b_written, b_waitedForRoom, b_roomReturned, b_refused, b_uDropped, b_queued, b_admitted,
          b_acked, b_smap, b_forgotten, b_reserved, b_ordered_write, b_sequenced_write,
          b_ordered_read, b_sequenced_watermark, b_sentTrace, b_trace, b_rxQueue, b_chunks,
          b_received, b_live, b_batch, b_phase, b_pending, b_duplicateReady, b_whole, b_placed,
          b_collision, b_uSent, b_uCount, b_seen, b_probeWrite, b_probeRead, b_resetOK, b_taken,
          b_notReceived, b_misused, b_deliveredCount, b_fwdWire, b_fwdSent, b_fwdPulse, b_revWire,
          b_revSent, b_revPulse

A == INSTANCE RNChannel WITH
       written <- a_written, waitedForRoom <- a_waitedForRoom, roomReturned <- a_roomReturned,
       refused <- a_refused, uDropped <- a_uDropped, queued <- a_queued, admitted <- a_admitted,
       acked <- a_acked, smap <- a_smap, forgotten <- a_forgotten, reserved <- a_reserved,
       ordered_write <- a_ordered_write, sequenced_write <- a_sequenced_write,
       ordered_read <- a_ordered_read, sequenced_watermark <- a_sequenced_watermark,
       sentTrace <- a_sentTrace, trace <- a_trace, rxQueue <- a_rxQueue, chunks <- a_chunks,
       received <- a_received, live <- a_live, batch <- a_batch, phase <- a_phase,
       pending <- a_pending, duplicateReady <- a_duplicateReady, whole <- a_whole,
       placed <- a_placed, collision <- a_collision, uSent <- a_uSent, uCount <- a_uCount,
       seen <- a_seen, probeWrite <- a_probeWrite, probeRead <- a_probeRead, resetOK <- a_resetOK,
       taken <- a_taken, notReceived <- a_notReceived, misused <- a_misused,
       deliveredCount <- a_deliveredCount, fwdWire <- a_fwdWire, fwdSent <- a_fwdSent,
       fwdPulse <- a_fwdPulse, revWire <- a_revWire, revSent <- a_revSent, revPulse <- a_revPulse
B == INSTANCE RNChannel WITH
       written <- b_written, waitedForRoom <- b_waitedForRoom, roomReturned <- b_roomReturned,
       refused <- b_refused, uDropped <- b_uDropped, queued <- b_queued, admitted <- b_admitted,
       acked <- b_acked, smap <- b_smap, forgotten <- b_forgotten, reserved <- b_reserved,
       ordered_write <- b_ordered_write, sequenced_write <- b_sequenced_write,
       ordered_read <- b_ordered_read, sequenced_watermark <- b_sequenced_watermark,
       sentTrace <- b_sentTrace, trace <- b_trace, rxQueue <- b_rxQueue, chunks <- b_chunks,
       received <- b_received, live <- b_live, batch <- b_batch, phase <- b_phase,
       pending <- b_pending, duplicateReady <- b_duplicateReady, whole <- b_whole,
       placed <- b_placed, collision <- b_collision, uSent <- b_uSent, uCount <- b_uCount,
       seen <- b_seen, probeWrite <- b_probeWrite, probeRead <- b_probeRead, resetOK <- b_resetOK,
       taken <- b_taken, notReceived <- b_notReceived, misused <- b_misused,
       deliveredCount <- b_deliveredCount, fwdWire <- b_fwdWire, fwdSent <- b_fwdSent,
       fwdPulse <- b_fwdPulse, revWire <- b_revWire, revSent <- b_revSent, revPulse <- b_revPulse

\* The rxQueue orders with each channel's order kept.
Interleavings(q) == {p \in [1..Len(q) -> A!Messages] :
                       \A c \in A!Channels : A!OnChannel(p, c) = A!OnChannel(q, c)}
\* The values B may take for each dropped variable: Vary names which vary.
PulseValues(x) == IF "pulse" \in Vary THEN {0, 1} ELSE {x}
FwdSentValues(x) == IF "sent" \in Vary THEN 0..A!Fwd!Horizon ELSE {x}
RevSentValues(x) == IF "sent" \in Vary THEN 0..A!Rev!Horizon ELSE {x}
QueueValues(q) == IF "queue" \in Vary THEN Interleavings(q) ELSE {q}
BAt(fp, rp, fs, rs, q) ==
 /\ b_written = a_written
 /\ b_waitedForRoom = a_waitedForRoom
 /\ b_roomReturned = a_roomReturned
 /\ b_refused = a_refused
 /\ b_uDropped = a_uDropped
 /\ b_queued = a_queued
 /\ b_admitted = a_admitted
 /\ b_acked = a_acked
 /\ b_smap = a_smap
 /\ b_forgotten = a_forgotten
 /\ b_reserved = a_reserved
 /\ b_ordered_write = a_ordered_write
 /\ b_sequenced_write = a_sequenced_write
 /\ b_ordered_read = a_ordered_read
 /\ b_sequenced_watermark = a_sequenced_watermark
 /\ b_sentTrace = a_sentTrace
 /\ b_trace = a_trace
 /\ b_rxQueue = q
 /\ b_chunks = a_chunks
 /\ b_received = a_received
 /\ b_live = a_live
 /\ b_batch = a_batch
 /\ b_phase = a_phase
 /\ b_pending = a_pending
 /\ b_duplicateReady = a_duplicateReady
 /\ b_whole = a_whole
 /\ b_placed = a_placed
 /\ b_collision = a_collision
 /\ b_uSent = a_uSent
 /\ b_uCount = a_uCount
 /\ b_seen = a_seen
 /\ b_probeWrite = a_probeWrite
 /\ b_probeRead = a_probeRead
 /\ b_resetOK = a_resetOK
 /\ b_taken = a_taken
 /\ b_notReceived = a_notReceived
 /\ b_misused = a_misused
 /\ b_deliveredCount = a_deliveredCount
 /\ b_fwdWire = a_fwdWire
 /\ b_fwdSent = fs
 /\ b_fwdPulse = fp
 /\ b_revWire = a_revWire
 /\ b_revSent = rs
 /\ b_revPulse = rp
BNext(fp, rp, fs, rs, q) ==
 /\ b_written' = a_written'
 /\ b_waitedForRoom' = a_waitedForRoom'
 /\ b_roomReturned' = a_roomReturned'
 /\ b_refused' = a_refused'
 /\ b_uDropped' = a_uDropped'
 /\ b_queued' = a_queued'
 /\ b_admitted' = a_admitted'
 /\ b_acked' = a_acked'
 /\ b_smap' = a_smap'
 /\ b_forgotten' = a_forgotten'
 /\ b_reserved' = a_reserved'
 /\ b_ordered_write' = a_ordered_write'
 /\ b_sequenced_write' = a_sequenced_write'
 /\ b_ordered_read' = a_ordered_read'
 /\ b_sequenced_watermark' = a_sequenced_watermark'
 /\ b_sentTrace' = a_sentTrace'
 /\ b_trace' = a_trace'
 /\ b_rxQueue' = q
 /\ b_chunks' = a_chunks'
 /\ b_received' = a_received'
 /\ b_live' = a_live'
 /\ b_batch' = a_batch'
 /\ b_phase' = a_phase'
 /\ b_pending' = a_pending'
 /\ b_duplicateReady' = a_duplicateReady'
 /\ b_whole' = a_whole'
 /\ b_placed' = a_placed'
 /\ b_collision' = a_collision'
 /\ b_uSent' = a_uSent'
 /\ b_uCount' = a_uCount'
 /\ b_seen' = a_seen'
 /\ b_probeWrite' = a_probeWrite'
 /\ b_probeRead' = a_probeRead'
 /\ b_resetOK' = a_resetOK'
 /\ b_taken' = a_taken'
 /\ b_notReceived' = a_notReceived'
 /\ b_misused' = a_misused'
 /\ b_deliveredCount' = a_deliveredCount'
 /\ b_fwdWire' = a_fwdWire'
 /\ b_fwdSent' = fs
 /\ b_fwdPulse' = fp
 /\ b_revWire' = a_revWire'
 /\ b_revSent' = rs
 /\ b_revPulse' = rp

VA == IF LossyView THEN A!LossySafetyView ELSE A!SafetyView
VB == IF LossyView THEN B!LossySafetyView ELSE B!SafetyView

Init ==
 /\ A!Init
 /\ \E fp \in PulseValues(a_fwdPulse), rp \in PulseValues(a_revPulse),
       fs \in FwdSentValues(a_fwdSent), rs \in RevSentValues(a_revSent),
       q \in QueueValues(a_rxQueue) : BAt(fp, rp, fs, rs, q)
 /\ VB = VA

Next ==
 /\ A!Next
 /\ \E fp \in PulseValues(a_fwdPulse'), rp \in PulseValues(a_revPulse'),
       fs \in FwdSentValues(a_fwdSent'), rs \in RevSentValues(a_revSent'),
       q \in QueueValues(a_rxQueue') : BNext(fp, rp, fs, rs, q)
 /\ VB' = VA'

Blank == [n |-> "", s |-> {}, p |-> 0, u |-> FALSE, m |-> 0, i |-> 0]
Plain == {"RefuseSend", "DropUnreliableForBudget", "Enqueue", "NumberRecord", "ReserveBeforeRoom", "OpenHead", "FixBatch", "Take", "SendAck", "EndUpdate", "ReceiveAckAny", "GhostSequencedWrite", "GhostSequencedRead"}
Labels ==
 {[Blank EXCEPT !.n = x] : x \in Plain}
 \cup {[Blank EXCEPT !.n = "Write", !.s = s, !.p = p, !.u = u] :
         s \in A!Loads \cup {{}}, p \in A!Pids, u \in BOOLEAN}
 \cup {[Blank EXCEPT !.n = "Deliver", !.m = m] : m \in A!Messages}
 \cup {[Blank EXCEPT !.n = k, !.i = i] :
         k \in {"FwdDrop", "FwdDup", "FwdReorder", "FwdDelay"}, i \in 1..Capacity}
 \cup {[Blank EXCEPT !.n = k, !.i = i] :
         k \in {"RevDrop", "RevDup", "RevReorder", "RevDelay"}, i \in 1..AckCapacity}
 \cup {[Blank EXCEPT !.n = k] : k \in {"FwdAge", "RevAge"}}

\* One labelled disjunct of RNChannel's Next. The environment labels pick
\* one Link step out of FwdEnvironment / RevEnvironment by conjunction.
StepA(l) ==
 /\ ~a_misused
 /\ \/ (l.n = "RefuseSend" /\ A!RefuseSend)
    \/ (l.n = "DropUnreliableForBudget" /\ A!DropUnreliableForBudget)
    \/ (l.n = "Enqueue" /\ A!Enqueue)
    \/ (l.n = "NumberRecord" /\ A!NumberRecord)
    \/ (l.n = "ReserveBeforeRoom" /\ A!ReserveBeforeRoom)
    \/ (l.n = "OpenHead" /\ A!OpenHead)
    \/ (l.n = "FixBatch" /\ A!FixBatch)
    \/ (l.n = "Take" /\ A!Take)
    \/ (l.n = "SendAck" /\ A!SendAck)
    \/ (l.n = "EndUpdate" /\ A!EndUpdate)
    \/ (l.n = "ReceiveAckAny" /\ A!ReceiveAckAny)
    \/ (l.n = "GhostSequencedWrite" /\ A!GhostSequencedWrite)
    \/ (l.n = "GhostSequencedRead" /\ A!GhostSequencedRead)
    \/ (l.n = "Write" /\ A!WritePacket(l.s, l.p, l.u))
    \/ (l.n = "Deliver" /\ A!DeliverMessage(l.m))
    \/ (l.n = "FwdDrop" /\ A!FwdEnvironment /\ A!Fwd!Drop(l.i))
    \/ (l.n = "FwdDup" /\ A!FwdEnvironment /\ A!Fwd!Duplicate(l.i))
    \/ (l.n = "FwdReorder" /\ A!FwdEnvironment /\ A!Fwd!Reorder(l.i))
    \/ (l.n = "FwdDelay" /\ A!FwdEnvironment /\ A!Fwd!Delay(l.i))
    \/ (l.n = "FwdAge" /\ MaxDelay > 0 /\ A!FwdEnvironment /\ A!Fwd!Age)
    \/ (l.n = "RevDrop" /\ A!RevEnvironment /\ A!Rev!Drop(l.i))
    \/ (l.n = "RevDup" /\ A!RevEnvironment /\ A!Rev!Duplicate(l.i))
    \/ (l.n = "RevReorder" /\ A!RevEnvironment /\ A!Rev!Reorder(l.i))
    \/ (l.n = "RevDelay" /\ A!RevEnvironment /\ A!Rev!Delay(l.i))
    \/ (l.n = "RevAge" /\ MaxDelay > 0 /\ A!RevEnvironment /\ A!Rev!Age)

StepB(l) ==
 /\ ~b_misused
 /\ \/ (l.n = "RefuseSend" /\ B!RefuseSend)
    \/ (l.n = "DropUnreliableForBudget" /\ B!DropUnreliableForBudget)
    \/ (l.n = "Enqueue" /\ B!Enqueue)
    \/ (l.n = "NumberRecord" /\ B!NumberRecord)
    \/ (l.n = "ReserveBeforeRoom" /\ B!ReserveBeforeRoom)
    \/ (l.n = "OpenHead" /\ B!OpenHead)
    \/ (l.n = "FixBatch" /\ B!FixBatch)
    \/ (l.n = "Take" /\ B!Take)
    \/ (l.n = "SendAck" /\ B!SendAck)
    \/ (l.n = "EndUpdate" /\ B!EndUpdate)
    \/ (l.n = "ReceiveAckAny" /\ B!ReceiveAckAny)
    \/ (l.n = "GhostSequencedWrite" /\ B!GhostSequencedWrite)
    \/ (l.n = "GhostSequencedRead" /\ B!GhostSequencedRead)
    \/ (l.n = "Write" /\ B!WritePacket(l.s, l.p, l.u))
    \/ (l.n = "Deliver" /\ B!DeliverMessage(l.m))
    \/ (l.n = "FwdDrop" /\ B!FwdEnvironment /\ B!Fwd!Drop(l.i))
    \/ (l.n = "FwdDup" /\ B!FwdEnvironment /\ B!Fwd!Duplicate(l.i))
    \/ (l.n = "FwdReorder" /\ B!FwdEnvironment /\ B!Fwd!Reorder(l.i))
    \/ (l.n = "FwdDelay" /\ B!FwdEnvironment /\ B!Fwd!Delay(l.i))
    \/ (l.n = "FwdAge" /\ MaxDelay > 0 /\ B!FwdEnvironment /\ B!Fwd!Age)
    \/ (l.n = "RevDrop" /\ B!RevEnvironment /\ B!Rev!Drop(l.i))
    \/ (l.n = "RevDup" /\ B!RevEnvironment /\ B!Rev!Duplicate(l.i))
    \/ (l.n = "RevReorder" /\ B!RevEnvironment /\ B!Rev!Reorder(l.i))
    \/ (l.n = "RevDelay" /\ B!RevEnvironment /\ B!Rev!Delay(l.i))
    \/ (l.n = "RevAge" /\ MaxDelay > 0 /\ B!RevEnvironment /\ B!Rev!Age)

InvariantsAgree ==
 /\ (A!TypeOK <=> B!TypeOK)
 /\ (A!OrderedExactlyOnceInOrder <=> B!OrderedExactlyOnceInOrder)
 /\ (A!WholeMessagesOnly <=> B!WholeMessagesOnly)
 /\ (A!ChunksPlacedByIndex <=> B!ChunksPlacedByIndex)
 /\ (A!UnreliableAtMostOnce <=> B!UnreliableAtMostOnce)
 /\ (A!BuffersBounded <=> B!BuffersBounded)
 /\ (A!NoSlotCollision <=> B!NoSlotCollision)
 /\ (A!NoSilentDrop <=> B!NoSilentDrop)
 /\ (A!NotReceivedEndsConnection <=> B!NotReceivedEndsConnection)
 /\ (A!OrderedTraceUnchangedBySequenced <=> B!OrderedTraceUnchangedBySequenced)

StepsAgree == \A l \in Labels :
 /\ (ENABLED StepA(l)) <=> (ENABLED StepB(l))
 /\ (ENABLED StepA(l)) => ENABLED (StepA(l) /\ StepB(l) /\ VA' = VB')

ViewSound == (VA = VB) => (InvariantsAgree /\ StepsAgree)

\* Labels cover Next: every step of A is some label's step.
LabelsCoverNext == (ENABLED A!Next) => \E l \in Labels : ENABLED StepA(l)

\* The instance bound: A explores only states with at most QueuedBound sends.
WithinBound == a_queued <= QueuedBound
=============================================================================
