-------------------------- MODULE MCServerStopSpread --------------------------
(***************************************************************************)
(* The small instances of ServerStopSpread: two slots, four connections,   *)
(* bursts of two packets, a staging of three frames and a ring of four     *)
(* entries (twice the two a running server keeps waiting).  A stop owes up *)
(* to eight packets, more than the staging holds, so it spreads across     *)
(* steps.  MCServerStopSpread.cfg: every invariant.                        *)
(* MCServerStopSpreadLive.cfg: the stop finishes under fairness;           *)
(* MCServerStopSpreadLiveNoRoom.cfg: it finishes also without a queue's    *)
(* room (one property a run, each within the record budget).  With two    *)
(* send queues: MCServerStopSpreadQueues.cfg, ...QueuesLive.cfg and the    *)
(* witness MCServerStopSpreadBrokenPooledRoom.cfg                          *)
(* (StopFinishesWithoutRoom).  With the development link simulator         *)
(* (Simulator = TRUE): MCServerStopSpreadSimulator.cfg (every invariant),  *)
(* ...SimulatorLive.cfg (StopFinishesWhileUnjammed), the witnesses         *)
(* MCServerStopSpreadBrokenStopWithHeld.cfg (NoCopyHeldAtStop) and         *)
(* MCServerStopSpreadBrokenNoLinkDrain.cfg (StopFinishesWhileUnjammed),    *)
(* and MCServerStopSpreadSimulatorJam.cfg, the open code defect: it fails  *)
(* StopFinishesWithoutRoom because the code cannot stop a jammed transport *)
(* while the simulator holds copies.  Reversed witnesses:                  *)
(* MCServerStopSpreadBrokenSingleShot.cfg (FullBurstBeforeStopped),        *)
(* MCServerStopSpreadBrokenStopInFlight.cfg (NoSendCutAtStop),             *)
(* MCServerStopSpreadBrokenRingSmall.cfg and                               *)
(* MCServerStopSpreadBrokenSteadyCapOffByOne.cfg (RingHolds),              *)
(* MCServerStopSpreadBrokenUnreachableStalls.cfg (StopFinishes),           *)
(* MCServerStopSpreadBrokenNoAbandon.cfg (StopFinishesWithoutRoom) and     *)
(* MCServerStopSpreadBrokenNoReread.cfg (NoDropWhileRoomCanReturn).        *)
(***************************************************************************)
EXTENDS ServerStopSpread
=============================================================================
