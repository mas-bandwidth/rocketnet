----------------------------- MODULE MCRNClientIocp -----------------------------
(***************************************************************************)
(* The small instance of RNClientIocp: two posted receives, two           *)
(* datagrams.  MCRNClientIocp.cfg is the committed run with every rule    *)
(* on and the give-up off, so a leak cannot meet its liveness properties; *)
(* MCRNClientIocpStalls.cfg the same over a kernel that never             *)
(* delivers the aborts after Close, where destroy leaks.                  *)
(* MCRNClientIocpBrokenFreeBeforeDrain.cfg lets Free follow Close at once *)
(* and must fail on FreedOnlyWhenDrained;                                 *)
(* MCRNClientIocpBrokenCopyPosted.cfg lets Drain copy a buffer not        *)
(* dequeued ready and must fail on NeverCopiedWhilePosted;                *)
(* MCRNClientIocpBrokenNoGiveUp.cfg and                                   *)
(* MCRNClientIocpBrokenNoGiveUpDrain.cfg take away destroy's give-up over *)
(* the stalled kernel and must fail on CloseEventuallyFrees and           *)
(* PostedDrainAfterClose.                                                 *)
(*                                                                         *)
(* The counterexamples against the code: BrokenNoGiveUp (and its Drain    *)
(* twin) posts a receive, closes, and stops: the kernel completes nothing *)
(* more, Free waits for Drained, and nothing is enabled but the stutter.  *)
(* In the code that is rocketnet_client_iocp_close looping on a dequeue   *)
(* that never lowers num_posted; the stalled count against max_waits      *)
(* (ROCKETNET_CLIENT_IOCP_DRAIN_WAITS from destroy) is what ends it, and  *)
(* destroy then leaks the transport rather than freeing it.               *)
(***************************************************************************)
EXTENDS RNClientIocp
=============================================================================
