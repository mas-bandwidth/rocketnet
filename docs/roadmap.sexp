    (:feature "CBMC proves the client packet readers free of out-of-bounds access up to the full packet size (later)" :cells (n - -) :note "planned after v1.0.0-preview-1")
    (:feature "CBMC proves the sequence buffers and replay window free of out-of-bounds access (later)" :cells (n - -) :note "planned after v1.0.0-preview-1")
    (:feature "ESBMC proofs: every rocketnet_assert on the proved paths is a checked property (later)" :cells (n - -) :note "planned after v1.0.0-preview-1")
