# Benign test-fixture allocations in unit tests registered with
# REGISTER_UNIT_TEST_EXPECTED_FAIL. When the expected check fails inside
# rocketnet_unit_check (test_unit_registry.h), the harness longjmps back to
# rocketnet_unit_tests_run_named before the test function reaches its
# end-of-scope fixture teardown, and the forked worker exits immediately.

# test_unit_sim_schedules.cpp: TestSimScheduleLongSkipStragglers allocates a
# simulator via sim_schedule_begin(&sched) and longjmps on the expected failure
# before sim_schedule_end(&sched).
leak:TestSimScheduleLongSkipStragglers

# test_unit_replay_trace.cpp: TestSlotlessPacketNeverMovesTheSessionWindow
# allocates server.encryption_map via rocketnet_encryption_map_create and
# longjmps on the expected failure before rocketnet_encryption_map_destroy.
leak:TestSlotlessPacketNeverMovesTheSessionWindow

# test_unit_handshake_witness.cpp: TestOneConnectionPerTokenAfterHistoryFlush
# allocates the server handshake fixture via rocketnet_handshake_server_setup
# and longjmps on the expected failure before rocketnet_handshake_server_teardown.
leak:TestOneConnectionPerTokenAfterHistoryFlush

# tests/functional/rocketnet_functional_tests.cpp: rocketnet_test_server_uring_create_stalled
# is the one noinline frame that creates the transport the probe deliberately
# stalls destroying, so this suppresses only that transport's abandoned memory,
# not every allocation made anywhere under the probe.
leak:rocketnet_test_server_uring_create_stalled
