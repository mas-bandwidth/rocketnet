<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- runs on any newer installed runtime; CI pins the 8.0 SDK -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The smoke exercises the development token-minting path (WriteDevConnectToken),
       so it builds the binding with ROCKETNET_DEVELOPMENT and loads the
       development shared library (librocketnet_dev), which carries the symbol the
       release library must not export. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);ROCKETNET_DEVELOPMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RocketNet.csproj" AdditionalProperties="RocketNetDevelopment=true" />
  </ItemGroup>

</Project>
