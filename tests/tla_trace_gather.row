# The trace check's row of tests/tla_trace_gather.cpp (proofs/tla/README-TraceCheck.md, "A layer's row"):
# a Python literal that tools/tla_trace_check.py reads with ast and never runs.
{
    "layer": "gather",
    "modules": ["RNSendGatherCall.tla", "TraceRNSendGatherCall.tla"],
    "untraced": {},
    "reach": ["SegCapEdge", "ByteCapEdge"],
    # seven steps a bank (six stages and the call): 100 calls a seed
    "steps": 700,
    # per commit: seed -> shard (ci.yml tla-trace, --seeds commit --shard I/N)
    "commit": {1: 3, 2: 3, 3: 3, 4: 3},
}
