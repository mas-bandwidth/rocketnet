# The trace check's row of tests/tla_trace_writer_finish.cpp (proofs/tla/README-TraceCheck.md, "A layer's row"):
# a Python literal that tools/tla_trace_check.py reads with ast and never runs.
{
    "layer": "writerfinish",
    "modules": ["RNWriterFinish.tla", "TraceRNWriterFinish.tla"],
    # the plants: each its own plant binary, built with that define alone (CMakeLists.txt)
    "plants": ["ROCKETNET_WRITER_FINISH_PLANT"],
    "untraced": {},
    # the walk's odd seeds are a staged transport (the first three predicates), its even seeds a buffered one
    # (the last three): a seed set must hold both kinds
    "reach": ["SealedAtFinish", "RefusedAtFinish", "NothingForWalk", "RingOpen", "RingQueued", "WalkCarried"],
    # per commit: seed -> shard (ci.yml tla-trace, --seeds commit --shard I/N)
    "commit": {1: 8, 2: 8, 3: 8, 4: 8},
}
