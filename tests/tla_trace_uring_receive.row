# The trace check's row of tests/tla_trace_uring_receive.cpp (proofs/tla/README-TraceCheck.md, "A layer's row"):
# a Python literal that tools/tla_trace_check.py reads with ast and never runs.
{
    "layer": "receive",
    "modules": ["RNUringQueueReceiveLayout.tla", "TraceRNUringQueueReceiveLayout.tla"],
    # the plants: each its own plant binary, built with that define alone (CMakeLists.txt)
    "plants": ["ROCKETNET_URING_RECEIVE_QUEUE_PLANT"],
    "untraced": {},
    "reach": ["BankFull", "RingDry"],
    # a record carries the datagrams banked and delivered so far, so TLC's
    # time grows faster than the walk: 200 steps a seed stays in budget
    "steps": 200,
    # per commit: seed -> shard (ci.yml tla-trace, --seeds commit --shard I/N)
    "commit": {1: 7, 2: 7, 3: 7, 4: 7},
}
