# Dictionary for tests/fuzz/rocketnet_fuzz_config.cpp. Entries are the header
# bytes' meaningful values and the value grammar the overlay parses
# (sdk/rocketnet_config.h, sdk/rocketnet_config.cpp), with the transport
# names from sdk/rocketnet_drivers.inc.

# table selectors (input[0] % 6): client transport, server transport,
# message as client, message as server, client budget, server budget
table_client="\x00"
table_server="\x01"
table_message_client="\x02"
table_message_server="\x03"
table_budget_client="\x04"
table_budget_server="\x05"

# mode bits: retired process-wide name, ladder check
mode_endpoint="\x00"
mode_retired="\x01"
mode_ladder="\x02"

# the strict integer parse: an optional leading minus, digits only
int_minus="-"
int_max="2147483647"
int_min="-2147483648"
int_over="2147483648"
uint64_max="18446744073709551615"
uint64_over="18446744073709551616"

# BYTES fields are base64 of exactly the field's length (ROCKETNET_CONFIG_KIND_BYTES)
b64_pad="="
b64_pad2="=="
# the published test filter value ROCKETNET_TEST_FILTER_VALUE, base64
b64_test_filter="t1kBAA=="

# the transport ladder: comma-separated names, "auto" (sdk/rocketnet_drivers.inc)
ladder_sep=","
ladder_auto="auto"
ladder_portable="portable"
ladder_loopback="loopback"
ladder_msgx="msgx"
ladder_gso="gso"
ladder_io_uring="io_uring"
ladder_iocp="iocp"
ladder_rio="rio"
ladder_xdp="xdp"
