# Dictionary for tests/fuzz/rocketnet_fuzz_differential.cpp. Each entry is the
# little-endian spelling of a field tag or constant in the structured case
# record (tools/differential/decide.h, the case model; the values the
# deciders compare against).

# address_mode selectors (input[0])
addr_ok="\x00"
addr_wrong_ip="\x01"
addr_v6_family="\x02"
addr_wrong_port="\x03"

# protocol_wrong (input[1])
prot_ok="\x00"
prot_wrong="\x01"

# flip_authenticator (input[2])
flip_off="\x00"
flip_on="\x01"

# replay (input[3])
replay_off="\x00"
replay_on="\x01"

# occupied_slots (input[4])
occ_zero="\x00"
occ_full="\x08"

# ROCKETNET_TEST_PROTOCOL_ID 0x1122334455667788 (sdk/rocketnet_test_vectors.h)
test_protocol_id="\x88\x77\x66\x55\x44\x33\x22\x11"

# timeout_seconds values (input[21..24]): 10 and 0
timeout_10="\x0a\x00\x00\x00"
timeout_0="\x00\x00\x00\x00"

# create_offset (input[5..12]) and expire_offset (input[13..20]) spellings
create_minus10="\xf6\xff\xff\xff\xff\xff\xff\xff"
expire_300="\x2c\x01\x00\x00\x00\x00\x00\x00"
expire_minus1="\xff\xff\xff\xff\xff\xff\xff\xff"
