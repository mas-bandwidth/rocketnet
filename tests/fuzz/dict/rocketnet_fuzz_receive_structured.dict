ipv4_address="\xcb\x00\x71\x0a\x40\x9c"

# rocketnet_dev_server_public_key (sdk/rocketnet_connect_token.cpp)
server_public_key="\x3d\x24\x90\x88\x9d\x37\x4c\x29\x6f\xab\x1d\x57\x70\xcb\x71\x47\x6a\x06\xf7\x4e\xf2\xf2\x54\x0c\xf2\x21\x5f\x76\x14\xf4\x80\x1c"

# An ack block with largest received 1, one range, and range length 1 (sdk/rocketnet_ack.h)
ack_block_one_range="\x01\x00\x00\x00\x01\x01\x00"

# An empty ack block with largest received 0 and no ranges (sdk/rocketnet_ack.h)
ack_block_empty="\x00\x00\x00\x00\x00\x00\x00"
