#!/usr/bin/env bash
#
# channel-seed-sweep's case dispatch, against a stand-in functional binary.
#
#   bash scripts/channel-seed-sweep-selftest
#
# The functional binary registers every case as test_<function> (the channel
# cases are written as `void <name>()` in functional/channel_*.cpp) and exits 2
# for a name it does not know. The stand-in here does the same, so a sweep that
# runs the bare function name fails every run, as the nightly did. Needs no
# build. Prints one line per leg; exits nonzero if any leg misbehaves.
#
#   1  --cases a,b      -- bare names are run as test_<name>: 4 runs, 0 failures
#   2  --cases test_a   -- a name given with its prefix is run once, unchanged
#   3  a failing case   -- the stand-in fails test_bad: its runs are reported

set -u
root=$( cd "$( dirname "$0" )/.." && pwd )
sweep="$root/scripts/channel-seed-sweep"
work=$( mktemp -d )
trap 'rm -rf "$work"' EXIT

fake="$work/functional"
cat > "$fake" <<'EOF'
#!/usr/bin/env bash
[ "${1:-}" = --run ] || exit 2
echo "$2" >> "${FAKE_LOG:?}"
case "$2" in
    test_bad) echo "check failed: ( bad ), function bad"; exit 1 ;;
    test_*) exit 0 ;;
    *) exit 2 ;;
esac
EOF
chmod +x "$fake"
export FAKE_LOG="$work/ran.log"
failed=0

: > "$FAKE_LOG"
out=$( bash "$sweep" --cases a,b --seeds 1-2 --jobs 2 --bin "$fake" 2>&1 ); rc=$?
ran=$( sort "$FAKE_LOG" | uniq | paste -sd, - )
if [ $rc -eq 0 ] && [ "$ran" = "test_a,test_b" ] && printf '%s\n' "$out" | grep -qx 'sweep: 4 runs, 0 failures'; then
    echo "leg 1  bare names run as test_<name>: green"
else
    echo "leg 1  bare names run as test_<name>: red, exit $rc, ran [$ran]"; printf '%s\n' "$out" | tail -3; failed=1
fi

: > "$FAKE_LOG"
out=$( bash "$sweep" --cases test_a --seeds 1-1 --bin "$fake" 2>&1 ); rc=$?
ran=$( paste -sd, - < "$FAKE_LOG" )
if [ $rc -eq 0 ] && [ "$ran" = "test_a" ]; then
    echo "leg 2  prefixed name run unchanged: green"
else
    echo "leg 2  prefixed name run unchanged: red, exit $rc, ran [$ran]"; failed=1
fi

: > "$FAKE_LOG"
out=$( bash "$sweep" --cases a,bad --seeds 1-2 --jobs 1 --bin "$fake" 2>&1 ); rc=$?
if [ $rc -ne 0 ] && printf '%s\n' "$out" | grep -qx 'sweep: 4 runs, 2 failures' && [ "$( printf '%s\n' "$out" | grep -c '^FAIL seed=[12] case=bad reason=bad$' )" = 2 ]; then
    echo "leg 3  failing case reported: green"
else
    echo "leg 3  failing case reported: red, exit $rc"; printf '%s\n' "$out" | tail -4; failed=1
fi

[ $failed -eq 0 ] || { echo "channel-seed-sweep-selftest: a leg failed"; exit 1; }
