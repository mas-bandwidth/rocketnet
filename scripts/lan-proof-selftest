#!/usr/bin/env bash
# Checks the dry run, the row parser, and the per-OS host facts, load and
# build through fake tools. Opens no socket and contacts no host.

set -u

here=$( cd "$( dirname "$0" )" && pwd )
proof="$here/lan-proof"
fail=0

say()
{
    echo "lan-proof-selftest: $*" >&2
    fail=1
}

parsed=$("$proof" --parse-row 'gso|server-a|1000|1000|120|yes|0|0:pass,1:pass,2:pass,3:pass,4:pass,5:pass,6:pass,7:pass|small:pass,fragmented:pass|800|pass') || say "parser exited $?"
echo "$parsed" | grep -q 'cell=gso' || say "parser missed the cell"
echo "$parsed" | grep -q 'modes=0:pass,1:pass,2:pass,3:pass,4:pass,5:pass,6:pass,7:pass' || say "parser missed mode verdicts"
echo "$parsed" | grep -q 'sizes=small:pass,fragmented:pass' || say "parser missed size verdicts"
echo "$parsed" | grep -q 'min_kbps=800' || say "parser missed min kbps"
"$proof" --parse-row 'short|row' >/dev/null 2>&1 && say "a short row was accepted"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cat > "$tmp/inventory" <<'EOF'
# label ssh role os iface uplink
server-a server-a.invalid server linux eth0 -
client-a client-a.invalid client linux eth0 -
EOF
mkdir -p "$tmp/bin"
cat > "$tmp/bin/ssh" <<'EOF'
#!/bin/sh
echo SSH-CALLED
exit 9
EOF
chmod +x "$tmp/bin/ssh"

out=$(PATH="$tmp/bin:$PATH" "$proof" --dry-run --inventory "$tmp/inventory" --cell gso --duration 120) || say "gso dry-run exited $?"
echo "$out" | grep -q 'dry-run: no host contacted' || say "dry-run did not say it contacted no host"
echo "$out" | grep -q 'cell gso' || say "dry-run missed the cell"
echo "$out" | grep -q 'check_split_load.py --load proof' || say "dry-run missed the proof check"
echo "$out" | grep -q 'SSH-CALLED' && say "dry-run printed an ssh call"

for cell in gso io_uring xdp iocp rio msgx; do
    PATH="$tmp/bin:$PATH" "$proof" --dry-run --inventory "$tmp/inventory" --cell "$cell" --duration 120 >"$tmp/one" || say "$cell dry-run exited $?"
    grep -q 'dry-run: no host contacted' "$tmp/one" || say "$cell dry-run contacted a host"
    grep -q 'SSH-CALLED' "$tmp/one" && say "$cell dry-run called ssh"
done

cat > "$tmp/uplink" <<'EOF'
server-a server-a.invalid server linux eth0 uplink
client-a client-a.invalid client linux eth0 -
EOF
"$proof" --dry-run --inventory "$tmp/uplink" --cell xdp --duration 120 >"$tmp/xdp" 2>&1 && say "xdp accepted an uplink"
grep -q 'refuses an uplink' "$tmp/xdp" || say "xdp refusal did not name the uplink"

# --xdp-uplink names the uplink: the dry run arms the self-detach before the
# attach and detaches after; it names only the server interface, and only
# for the xdp cell
PATH="$tmp/bin:$PATH" "$proof" --dry-run --inventory "$tmp/uplink" --cell xdp --duration 120 --xdp-uplink eth0 >"$tmp/xdp-uplink" 2>&1 ||
    say "xdp --xdp-uplink dry-run exited $?: $(cat "$tmp/xdp-uplink")"
grep -q 'SSH-CALLED' "$tmp/xdp-uplink" && say "xdp --xdp-uplink dry-run called ssh"
grep -q 'dry-run: no host contacted' "$tmp/xdp-uplink" || say "xdp --xdp-uplink dry-run contacted a host"
arm_line=$( grep -n 'arm self-detach timer through systemd-run: at 420 s kill the server and set eth0 xdp off' "$tmp/xdp-uplink" | cut -d: -f1 | head -n 1 )
attach_line=$( grep -n 'attach: start server bare metal transport xdp on eth0' "$tmp/xdp-uplink" | cut -d: -f1 | head -n 1 )
detach_line=$( grep -n 'detach xdp from eth0, cancel the timer, check ip link shows no xdp' "$tmp/xdp-uplink" | cut -d: -f1 | head -n 1 )
[ -n "$arm_line" ] || say "xdp --xdp-uplink dry-run printed no timer step"
[ -n "$attach_line" ] || say "xdp --xdp-uplink dry-run printed no attach step"
[ -n "$detach_line" ] || say "xdp --xdp-uplink dry-run printed no detach step"
[ -n "$arm_line" ] && [ -n "$attach_line" ] && [ "$arm_line" -lt "$attach_line" ] ||
    say "xdp --xdp-uplink dry-run did not print the timer step before the attach step"
[ -n "$attach_line" ] && [ -n "$detach_line" ] && [ "$attach_line" -lt "$detach_line" ] ||
    say "xdp --xdp-uplink dry-run did not print the detach step after the attach step"
grep -q 'runs in a guest' "$tmp/xdp-uplink" && say "xdp --xdp-uplink dry-run still named the guest"
"$proof" --dry-run --inventory "$tmp/uplink" --cell xdp --duration 120 --xdp-uplink eth1 >"$tmp/xdp-other" 2>&1 &&
    say "xdp --xdp-uplink accepted an interface that is not the server's"
grep -q 'names eth1 but the server interface is eth0' "$tmp/xdp-other" || say "xdp --xdp-uplink mismatch refusal was unclear"
"$proof" --dry-run --inventory "$tmp/uplink" --cell gso --duration 120 --xdp-uplink eth0 >"$tmp/xdp-gso" 2>&1 &&
    say "--xdp-uplink was accepted for a cell other than xdp"
grep -q 'for the xdp cell only' "$tmp/xdp-gso" || say "--xdp-uplink non-xdp refusal was unclear"

# the remote uplink steps through a fake sudo, systemd-run, systemctl, ip
# and pkill: the attach is refused while no timer is armed, the timer is
# armed with the detach command, and the detach cancels the timer and checks
# ip link
mkdir -p "$tmp/uplinkbin" "$tmp/uplinklog"
printf '%s\n' '#!/bin/sh' '[ "$1" = "-n" ] && shift' 'echo "$*" >> "$FAKE_UPLINK_LOG/sudo.args"' 'exec "$@"' > "$tmp/uplinkbin/sudo"
printf '%s\n' '#!/bin/sh' 'echo "$*" > "$FAKE_UPLINK_LOG/systemd-run.args"' ': > "$FAKE_UPLINK_LOG/timer.armed"' > "$tmp/uplinkbin/systemd-run"
printf '%s\n' '#!/bin/sh' 'case "$1" in' \
    '    is-active) [ -f "$FAKE_UPLINK_LOG/timer.armed" ] ;;' \
    '    stop) echo "stop $2" >> "$FAKE_UPLINK_LOG/systemctl.args"; rm -f "$FAKE_UPLINK_LOG/timer.armed" ;;' \
    'esac' > "$tmp/uplinkbin/systemctl"
printf '%s\n' '#!/bin/sh' 'case "$*" in' \
    '    *" off") echo "$*" >> "$FAKE_UPLINK_LOG/ip.args"; rm -f "$FAKE_UPLINK_LOG/xdp.attached" ;;' \
    '    "link show dev eth0")' \
    '        if [ -f "$FAKE_UPLINK_LOG/xdp.attached" ]; then echo "2: eth0: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu 1500 xdp qdisc mq state UP";' \
    '        else echo "2: eth0: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu 1500 qdisc mq state UP"; fi ;;' \
    '    *) echo "2: eth0    inet 192.0.2.10/24 brd 192.0.2.255 scope global eth0" ;;' \
    'esac' > "$tmp/uplinkbin/ip"
printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$FAKE_UPLINK_LOG/pkill.args"' > "$tmp/uplinkbin/pkill"
chmod +x "$tmp/uplinkbin"/*
uplink_fakes()
{
    PATH="$tmp/uplinkbin:$PATH" FAKE_UPLINK_LOG="$tmp/uplinklog" LAN_PROOF_BASE="$tmp/uplinkbase" LAN_PROOF_OS=linux "$@"
}
uplink_fakes "$here/lan-proof-remote" start-xdp-uplink-server 0123456789abcdef "$tmp/uplinkrun" eth0 30 30 0123456789abcdef 192.0.2.10 40000 600000 >"$tmp/uplink-unarmed" 2>&1 &&
    say "the uplink server started with no self-detach armed"
grep -q 'is not armed; refusing the attach' "$tmp/uplink-unarmed" || say "the unarmed refusal was unclear: $(cat "$tmp/uplink-unarmed")"
[ -e "$tmp/uplinkrun/server.pid" ] && say "the unarmed uplink server recorded a process"
armed=$( uplink_fakes "$here/lan-proof-remote" arm-xdp-detach eth0 0123456789abcdef 420 ) || say "arm-xdp-detach exited $?"
[ "$armed" = "xdp-detach-armed: unit=lan-proof-xdp-detach-0123456789abcdef.timer iface=eth0 fires_in_s=420" ] ||
    say "arm-xdp-detach printed '$armed'"
grep -q -- '--unit lan-proof-xdp-detach-0123456789abcdef --on-active=420s' "$tmp/uplinklog/systemd-run.args" ||
    say "the timer was not armed for 420 s: $(cat "$tmp/uplinklog/systemd-run.args")"
grep -qF "pkill -KILL -f 'load_split serve[r] [0-9]+ [0-9]+ 0123456789abcdef'; ip link set dev eth0 xdpgeneric off; ip link set dev eth0 xdpdrv off; ip link set dev eth0 xdp off" "$tmp/uplinklog/systemd-run.args" ||
    say "the timer does not kill the server and detach xdp: $(cat "$tmp/uplinklog/systemd-run.args")"
uplink_fakes "$here/lan-proof-remote" arm-xdp-detach 'eth0;x' 0123456789abcdef 420 >/dev/null 2>&1 &&
    say "arm-xdp-detach accepted an unsafe interface name"
: > "$tmp/uplinklog/xdp.attached"
detached=$( uplink_fakes "$here/lan-proof-remote" detach-xdp-uplink eth0 0123456789abcdef ) || say "detach-xdp-uplink exited $?"
printf '%s\n' "$detached" | grep -qx 'xdp-detached: iface=eth0 xdp=none timer=lan-proof-xdp-detach-0123456789abcdef.timer not armed' ||
    say "detach-xdp-uplink printed '$detached'"
grep -q 'stop lan-proof-xdp-detach-0123456789abcdef.timer' "$tmp/uplinklog/systemctl.args" || say "the detach did not cancel the timer"
grep -q 'link set dev eth0 xdp off' "$tmp/uplinklog/ip.args" || say "the detach did not set xdp off"
[ -f "$tmp/uplinklog/timer.armed" ] && say "the detach left the timer armed"

# only the server's interface marked uplink refuses the xdp cell; a client's
# uplink mark does not
cat > "$tmp/client-uplink" <<'EOF'
server-a server-a.invalid server linux eth0 -
client-a client-a.invalid client linux eth0 uplink
EOF
PATH="$tmp/bin:$PATH" "$proof" --dry-run --inventory "$tmp/client-uplink" --cell xdp --duration 120 >"$tmp/xdp-client-uplink" 2>&1 ||
    say "xdp refused a client's uplink mark: $(cat "$tmp/xdp-client-uplink")"

# an inventory whose last row has no newline still has that row
printf 'server-a server-a.invalid server linux eth0 -\nclient-a client-a.invalid client linux eth0 -' > "$tmp/no-newline"
PATH="$tmp/bin:$PATH" "$proof" --dry-run --inventory "$tmp/no-newline" --cell gso --duration 120 >"$tmp/no-newline.out" 2>&1 ||
    say "the last inventory row without a newline was dropped: $(cat "$tmp/no-newline.out")"

sed 's/server linux/server macos/' "$tmp/inventory" > "$tmp/nonlinux"
"$proof" --dry-run --inventory "$tmp/nonlinux" --cell xdp --duration 120 >"$tmp/xdp-nonlinux" 2>&1 &&
    say "xdp accepted a non-Linux server"
grep -q 'needs a Linux server' "$tmp/xdp-nonlinux" || say "xdp non-Linux refusal was unclear"

# the xdp guest is sized from a fake server plan and refused when the host
# cannot hold it
mkdir -p "$tmp/xdpbase/0123456789abcdef/bin"
cat > "$tmp/xdpbase/0123456789abcdef/bin/load_split" <<'EOF'
#!/bin/sh
[ "$1" = "plan-server" ] && [ "$2" = "1000" ] &&
    echo 'split_plan: role=server total=1000 local=1000 server_public_required_bytes=18394142400 verdict=PASS'
EOF
chmod +x "$tmp/xdpbase/0123456789abcdef/bin/load_split"
printf 'MemTotal:       131072000 kB\nMemAvailable:   125829120 kB\n' > "$tmp/meminfo-large"
printf 'MemTotal:       16777216 kB\nMemAvailable:   16252928 kB\n' > "$tmp/meminfo-small"
xdp_command=$(LAN_PROOF_BASE="$tmp/xdpbase" LAN_PROOF_MEMINFO="$tmp/meminfo-large" "$here/lan-proof-remote" xdp-command \
    0123456789abcdef "$tmp/run" test-bridge 1000 60 0123456789abcdef 40000 600000) ||
    say "xdp command exited $?"
echo "$xdp_command" | grep -q 'vng --run' || say "xdp command missed vng"
# (18394142400 + 1000 * 9848630) * 5 / 4 + 1 GiB = 33.9 GiB, rounded up
echo "$xdp_command" | grep -q -- '--memory 34G --cpus 3' || say "xdp command missed the planned guest size: $xdp_command"
LAN_PROOF_BASE="$tmp/xdpbase" LAN_PROOF_MEMINFO="$tmp/meminfo-small" "$here/lan-proof-remote" xdp-command \
    0123456789abcdef "$tmp/run" test-bridge 1000 60 0123456789abcdef 40000 600000 >"$tmp/xdp-small" 2>&1 &&
    say "xdp command accepted a host that cannot hold the guest"
grep -q 'needs 34 GiB and the host has 15 GiB available' "$tmp/xdp-small" || say "xdp memory refusal was unclear: $(cat "$tmp/xdp-small")"
echo "$xdp_command" | grep -q 'irqaffinity=0.*isolcpus=1-2.*nohz_full=1-2' || say "xdp command missed boot isolation"
echo "$xdp_command" | grep -q -- '--network bridge=test-bridge' || say "xdp command missed the dedicated bridge"
echo "$xdp_command" | grep -q 'guest-server' || say "xdp command missed the guest server"
echo "$xdp_command" | grep -q 'scripts/lan-proof-remote.*guest-server' || say "xdp command used a helper outside the shared checkout"

cat > "$tmp/server.log" <<'EOF'
split_ready: schema=split_v1 role=server run_id=0123456789abcdef total=1000 duration_s=120 profile=default payload_bytes=proof rate_target_hz=10 load=proof address=192.0.2.10:40000 key=00 transport=gso startup_utc_s=1 transport_pin=gso
split_proof: role=server run_id=0123456789abcdef transport=gso transport_pin=gso small_bytes=1200 fragmented_bytes=2000 target_kbps=256 min_client_up_kbps=277.859200 min_client_down_kbps=279.153067 checksum_errors=0 receipt_errors=0 receipts_dropped=0 disconnects=0 verdict=PASS
EOF
cat > "$tmp/merge.log" <<'EOF'
split_proof_cell: verdict=PASS transport=gso total=1000 streams=26000 messages_sent=2400000 messages_delivered=2399996 unreliable_lost=4 sequenced_skipped=0 timing_verdict=FAIL
EOF
row=$("$proof" --cell-row gso server-a 1000 1000 120 "$tmp/server.log" "$tmp/merge.log") || say "cell-row exited $?"
[ "$row" = 'gso|server-a|1000|1000|120|yes|0|0:pass,1:pass,2:pass,3:pass,4:pass,5:pass,6:pass,7:pass|small:pass,fragmented:pass|277|pass' ] || say "cell-row printed '$row'"
# a disconnect makes the row's verdict fail, and that is the exit status
sed 's/disconnects=0/disconnects=2/' "$tmp/server.log" > "$tmp/server-disc.log"
row=$("$proof" --cell-row gso server-a 1000 1000 120 "$tmp/server-disc.log" "$tmp/merge.log")
status=$?
[ "$status" -eq 1 ] || say "cell-row with a fail verdict exited $status, not 1"
case "$row" in
    *'|no|2|'*'|fail') ;;
    *) say "cell-row with a disconnect printed '$row'" ;;
esac

# Per-OS host facts, load and build through fakes: no host, no socket.
remote="$here/lan-proof-remote"
fake="$tmp/fake"
mkdir -p "$fake" "$tmp/home/bin"
fake_commit=0123456789abcdef0123456789abcdef01234567

cat > "$fake/ifconfig" <<'EOF'
#!/bin/sh
printf '%s\n' 'en0: flags=8863<UP,BROADCAST,SMART,RUNNING,SIMPLEX,MULTICAST> mtu 1500' \
    '	inet 192.0.2.33 netmask 0xffffff00 broadcast 192.0.2.255' \
    '	media: autoselect (1000baseT <full-duplex,flow-control>)' \
    '	status: active'
EOF
cat > "$fake/route" <<'EOF'
#!/bin/sh
printf '%s\n' '   route to: default' '  interface: en0'
EOF
cat > "$fake/sysctl" <<'EOF'
#!/bin/sh
case "$2" in
    vm.loadavg) echo '{ 6.20 3.99 3.76 }' ;;
    hw.ncpu) echo "${FAKE_NCPU:-18}" ;;
esac
EOF
cat > "$fake/networksetup" <<'EOF'
#!/bin/sh
printf '%s\n' 'Hardware Port: Thunderbolt Bridge' 'Device: bridge0' '' 'Hardware Port: Ethernet' 'Device: en0'
EOF
cat > "$fake/powershell.exe" <<'EOF'
#!/bin/sh
if [ -n "${FAKE_PS_FAIL:-}" ]; then echo "powershell: the query failed" >&2; exit 1; fi
case "$*" in
    *"\$i = ''"*) ;;
    *) printf 'name=Ethernet_4\r\nmodel=Example 10G Adapter\r\ndriver=example.sys\r\nspeed_bps=10000000000\r\nfull_duplex=True\r\naddress=192.0.2.46\r\nkernel=10.0.26200\r\n' ;;
esac
printf 'nproc=%s\r\ncpu_percent=3\r\nqueue=0\r\n' "${FAKE_NPROC:-64}"
EOF
cat > "$fake/wslpath" <<'EOF'
#!/bin/sh
echo "W:$2"
EOF
cat > "$fake/cmd.exe" <<'EOF'
#!/bin/sh
bat=${2#W:}
cp "$bat" "$FAKE_LOG/build.bat"
dir=$( sed -n 's/^cd \/d "W:\(.*\)" .*/\1/p' "$bat" | tr -d '\r' )
mkdir -p "$dir/bin/Release" && : > "$dir/bin/Release/load_split.exe"
EOF
cat > "$fake/winlock" <<'EOF'
#!/bin/sh
echo "$*" > "$FAKE_LOG/winlock.args"
while [ $# -gt 0 ] && [ "$1" != "--" ]; do shift; done
shift
exec "$@"
EOF
cat > "$fake/git" <<'EOF'
#!/bin/sh
case "$1" in
    clone) mkdir -p "$4/.git" ;;
    -C)
        case "$3" in
            rev-parse) echo "$FAKE_COMMIT" ;;
        esac
        ;;
esac
EOF
cat > "$tmp/home/bin/benchslot" <<'EOF'
#!/bin/sh
echo "$*" > "$FAKE_LOG/benchslot.args"
for last in "$@"; do :; done
mkdir -p "$last/bin" && : > "$last/bin/load_split" && chmod +x "$last/bin/load_split"
EOF
chmod +x "$fake"/* "$tmp/home/bin/benchslot"
mkdir -p "$tmp/log"
fakes()
{
    PATH="$fake:$PATH" HOME="$tmp/home" FAKE_LOG="$tmp/log" FAKE_COMMIT=$fake_commit \
        LAN_PROOF_BASE="$tmp/base" LAN_PROOF_WIN_BASE="$tmp/winbase" "$@"
}

mac=$( fakes env LAN_PROOF_OS=macos "$remote" hostinfo default ) || say "macos hostinfo exited $?"
[ "$mac" = "os=Darwin kernel=$( uname -r ) iface=en0 model=Ethernet driver=unknown speed_mbps=1000 duplex=Full address=192.0.2.33 load1=6.20 nproc=18" ] ||
    say "macos hostinfo printed '$mac'"
mac=$( fakes env LAN_PROOF_OS=macos "$remote" load ) || say "macos load exited $?"
[ "$mac" = "load1=6.20 nproc=18" ] || say "macos load printed '$mac'"
fakes env LAN_PROOF_OS=macos FAKE_NCPU=many "$remote" load >/dev/null 2>&1 && say "macos load accepted a non-numeric core count"

[ -f "$tmp/log/winlock.args" ] && say "a macOS command took a Windows lock"

win=$( fakes env LAN_PROOF_OS=windows "$remote" hostinfo Ethernet_4 ) || say "windows hostinfo exited $?"
grep -q -- '--slots 3 --card lan-proof -- .*lan-proof-remote hostinfo Ethernet_4' "$tmp/log/winlock.args" ||
    say "windows hostinfo did not run inside a shared slot"
[ "$win" = "os=Windows kernel=10.0.26200 iface=Ethernet_4 model=Example 10G Adapter driver=example.sys speed_mbps=10000 duplex=Full address=192.0.2.46 load1=1.92 nproc=64" ] ||
    say "windows hostinfo printed '$win'"
win=$( fakes env LAN_PROOF_OS=windows "$remote" load ) || say "windows load exited $?"
[ "$win" = "load1=1.92 nproc=64" ] || say "windows load printed '$win'"
grep -q -- '--slots 3 .*lan-proof-remote load' "$tmp/log/winlock.args" || say "windows load did not run inside a shared slot"
for step in "alive $tmp/none.pid" "stop $tmp/none.pid" "collect $tmp/inventory"; do
    rm -f "$tmp/log/winlock.args"
    fakes env LAN_PROOF_OS=windows "$remote" $step >/dev/null 2>&1
    grep -q -- "--slots 3 .*lan-proof-remote ${step%% *}" "$tmp/log/winlock.args" 2>/dev/null ||
        say "windows ${step%% *} did not run inside a shared slot"
done
# inside a held cell a command of that cell's run runs within that lock
# instead of queueing; a command of another run, or of no run, queues
mkdir -p "$tmp/base"
echo "$$ 0123456789abcdef" > "$tmp/base/cell.holder"
rm -f "$tmp/log/winlock.args"
win=$( fakes env LAN_PROOF_OS=windows "$remote" --run 0123456789abcdef load ) || say "windows load in a held cell exited $?"
[ "$win" = "load1=1.92 nproc=64" ] || say "windows load in a held cell printed '$win'"
[ -f "$tmp/log/winlock.args" ] && say "a command inside the held cell queued for another lock"
rm -f "$tmp/log/winlock.args"
fakes env LAN_PROOF_OS=windows "$remote" --run fedcba9876543210 load >/dev/null 2>&1 || say "windows load of another run exited $?"
grep -q -- '--slots 3 --card lan-proof-fedcba9876543210 -- .*lan-proof-remote --run fedcba9876543210 load' "$tmp/log/winlock.args" 2>/dev/null ||
    say "a command of another run used the held cell instead of queueing for a shared slot"
rm -f "$tmp/log/winlock.args"
fakes env LAN_PROOF_OS=windows "$remote" load >/dev/null 2>&1 || say "windows load of no run exited $?"
[ -f "$tmp/log/winlock.args" ] || say "a command naming no run used the held cell"
rm -f "$tmp/base/cell.holder"
# a failed PowerShell query is refused by name, its own error kept
fakes env LAN_PROOF_OS=windows FAKE_PS_FAIL=1 "$remote" hostinfo Ethernet_4 >"$tmp/ps-fail" 2>&1 &&
    say "windows hostinfo passed a failed PowerShell query"
grep -q "facts: powershell failed" "$tmp/ps-fail" && grep -q "the query failed" "$tmp/ps-fail" ||
    say "a failed PowerShell query was not named: $(cat "$tmp/ps-fail")"
fakes env LAN_PROOF_OS=windows FAKE_NPROC=x "$remote" hostinfo Ethernet_4 >/dev/null 2>&1 &&
    say "windows hostinfo accepted a non-numeric core count"
fakes env LAN_PROOF_OS=windows "$remote" hostinfo "Ethernet 4;x" >/dev/null 2>&1 &&
    say "windows hostinfo accepted an unsafe interface name"

out=$( fakes env LAN_PROOF_OS=macos "$remote" build $fake_commit ) || say "macos build exited $?"
[ "$( printf '%s\n' "$out" | tail -n 1 )" = "$fake_commit" ] || say "macos build did not end with the head"
printf '%s\n' "$out" | grep -qx "bin=$tmp/base/$fake_commit/bin/load_split" || say "macos build named no load_split"
grep -q 'cmake -DCMAKE_BUILD_TYPE=Release' "$tmp/log/benchslot.args" && grep -q 'make -j4' "$tmp/log/benchslot.args" ||
    say "macos build did not run the Release make build under the bench slot"

out=$( fakes env LAN_PROOF_OS=windows "$remote" build $fake_commit ) || say "windows build exited $?"
[ "$( printf '%s\n' "$out" | tail -n 1 )" = "$fake_commit" ] || say "windows build did not end with the head"
printf '%s\n' "$out" | grep -qx "bin=$tmp/winbase/$fake_commit/bin/Release/load_split.exe" ||
    say "windows build did not resolve the Release load_split.exe"
grep -q 'cmake -B build -G "Visual Studio 18 2026" -A x64' "$tmp/log/build.bat" ||
    say "windows build did not configure the multi-config generator"
grep -q 'cmake --build build --config Release --parallel 4' "$tmp/log/build.bat" ||
    say "windows build did not build Release with 4 jobs"
grep -q -- '--slots 3' "$tmp/log/winlock.args" || say "windows build did not take a shared slot"
grep -q -- '--slots 3 --card lan-proof -- .*lan-proof-remote build '"$fake_commit" "$tmp/log/winlock.args" ||
    say "windows checkout and build did not run inside the shared slot"
grep -q -- '--exclusive' "$tmp/log/winlock.args" && say "windows build took the exclusive lock"

# hold-server returns only after the server it started has exited
mkdir -p "$tmp/winbase/$fake_commit/bin/Release"
cat > "$tmp/winbase/$fake_commit/bin/Release/load_split.exe" <<'EOF'
#!/bin/sh
echo 'split_ready: role=server address=192.0.2.46:40000 key=00'
sleep 1
: > "$FAKE_LOG/server-exited"
EOF
chmod +x "$tmp/winbase/$fake_commit/bin/Release/load_split.exe"
rm -f "$tmp/log/winlock.args"
held=$( fakes env LAN_PROOF_OS=windows "$remote" hold-server $fake_commit "$tmp/run" iocp 4 1 0123456789abcdef 192.0.2.46 40000 600000 ) ||
    say "hold-server exited $?"
[ -f "$tmp/log/server-exited" ] || say "hold-server returned while its server was running"
printf '%s\n' "$held" | grep -q '^split_ready: ' || say "hold-server did not report the ready line"
[ -f "$tmp/base/cell.holder" ] && say "hold-server left its cell mark"
[ -f "$tmp/log/winlock.args" ] && say "hold-server queued for a lock inside its own cell"
# The live run against fake hosts: a fake ssh records every call and answers
# each step of lan-proof-remote, scp copies nothing, sleep returns at once and,
# where a case asks, `date +%s` reads 100 s later on every call. No host, no
# socket, and no time passes.
live="$tmp/live"
mkdir -p "$live/bin"
cat > "$live/bin/ssh" <<'EOF'
#!/usr/bin/env bash
while [ $# -gt 0 ]; do
    case "$1" in
        -o) shift 2 ;;
        -*) shift ;;
        *) break ;;
    esac
done
host=$1
shift
echo "$host $*" >> "$FAKE_LOG"
# ssh joins its arguments into one line for the remote shell: split it here too
set -- $*
case "$1" in
    mkdir|chmod) exit 0 ;;
    winlock)
        case " $* " in
            *" --exclusive "*)
                # hold-server: the ready line, then held until teardown ends it
                echo "split_ready: role=server address=192.0.2.10:40000 key=00"
                exec /bin/sleep 600 ;;
        esac
        exit 0 ;;
esac
shift
[ "${1:-}" = "--run" ] && shift 2
sub=${1:-}
case "$sub" in
    build) echo "$FAKE_COMMIT" ;;
    hostinfo) echo "os=Linux kernel=6 iface=eth0 model=m driver=d speed_mbps=1000 duplex=Full address=192.0.2.10 load1=0.10 nproc=64" ;;
    load) echo "load1=0.10 nproc=64" ;;
    start-server) : ;;
    start-shard)
        if [ "$4" = "${FAKE_TERM_SHARD:-none}" ]; then
            kill -TERM "$( cat "$FAKE_PID_FILE" )"
        fi
        [ "$4" = "${FAKE_FAIL_SHARD:-none}" ] && exit 1 ;;
    collect)
        case "$2" in
            *server.log) echo "split_ready: role=server address=192.0.2.10:40000 key=00" ;;
        esac ;;
    alive) [ -n "${FAKE_ALIVE:-}" ] || exit 1 ;;
    stop) : ;;
    *) echo "fake ssh: unexpected step: $*" >&2; exit 99 ;;
esac
exit 0
EOF
printf '%s\n' '#!/bin/sh' 'exit 0' > "$live/bin/scp"
printf '%s\n' '#!/bin/sh' 'exit 0' > "$live/bin/sleep"
cat > "$live/bin/date" <<'EOF'
#!/usr/bin/env bash
if [ "$*" = "+%s" ] && [ -n "${FAKE_CLOCK_FILE:-}" ]; then
    ticks=$( cat "$FAKE_CLOCK_FILE" 2>/dev/null || echo 0 )
    echo $(( ticks + 1 )) > "$FAKE_CLOCK_FILE"
    echo $(( 1000 + ticks * 100 ))
    exit 0
fi
exec /bin/date "$@"
EOF
chmod +x "$live/bin"/*
printf '%s\n' 'server-a server-a.invalid server linux eth0 -' 'client-a client-a.invalid client linux eth0 -' > "$live/inventory"
printf '%s\n' 'server-w server-w.invalid server windows Ethernet_4 -' 'client-a client-a.invalid client linux eth0 -' > "$live/inventory-windows"
live_run_id=0123456789abcdef

# live_run NAME INVENTORY CLIENTS DURATION [VAR=VALUE...]: one run, its calls in
# $live/NAME.log, its output in $live/NAME.out and its status returned
live_run()
{
    local name=$1 inv=$2 clients=$3 duration=$4 pid status
    shift 4
    : > "$live/$name.log"
    env "$@" PATH="$live/bin:$PATH" FAKE_LOG="$live/$name.log" FAKE_COMMIT=$fake_commit FAKE_PID_FILE="$live/$name.pid" \
        bash "$proof" --inventory "$inv" --cell gso --duration "$duration" --clients "$clients" \
        --commit "$fake_commit" --run-id "$live_run_id" --run-dir "$live/$name.run" > "$live/$name.out" 2>&1 < /dev/null &
    pid=$!
    echo "$pid" > "$live/$name.pid"
    wait "$pid"
    status=$?
    return "$status"
}

# teardown stops every shard the run started, however many: --clients 2500
# is shard0 .. shard9, and the start of shard9 fails
live_run shards "$live/inventory" 2500 1 FAKE_FAIL_SHARD=shard9 && say "a run whose shard9 failed to start passed"
for s in 0 7 8 9; do
    grep -q "^client-a.invalid .*lan-proof-remote.* stop ~/lan-proof-live/runs/$live_run_id/shard$s.pid" "$live/shards.log" ||
        say "teardown did not stop shard$s"
done

# a TERM tears down and ends the run: no step after it runs
live_run term "$live/inventory" 1000 1 FAKE_TERM_SHARD=shard1
status=$?
[ "$status" -eq 130 ] || say "a TERM mid-run exited $status, not 130"
grep -q "start-shard .* shard2 " "$live/term.log" && say "a step after the TERM ran: shard2 was started"
grep -q "stop ~/lan-proof-live/runs/$live_run_id/shard1.pid" "$live/term.log" || say "the TERM did not tear down"

# the wait for the started processes is bounded by the wall clock: with every
# round taking 100 s (each date call), a 1 s cell (bound 301 s) ends within a
# few rounds, not after 60 sleeps of 5 s
live_run wallclock "$live/inventory" 250 1 FAKE_ALIVE=1 FAKE_CLOCK_FILE="$live/wallclock.clock" &&
    say "a run whose processes never ended passed"
grep -q "outlived its bound" "$live/wallclock.out" || say "a run whose processes never ended was not bounded: $(tail -n 2 "$live/wallclock.out")"
rounds=$( grep -c "alive ~/lan-proof-live/runs/$live_run_id/server.pid" "$live/wallclock.log" )
[ "$rounds" -le 10 ] || say "the wait ran $rounds rounds: its bound counts sleeps, not the wall clock"

# a Windows server: the script copy takes a shared slot and the server is
# started by hold-server under the exclusive lock, both carded for this run,
# and every remote step names the run
live_run windows "$live/inventory-windows" 250 1 FAKE_FAIL_SHARD=shard0 && say "a Windows run whose shard0 failed passed"
grep -q "^server-w.invalid winlock --slots 3 --card lan-proof-$live_run_id -- " "$live/windows.log" ||
    say "the Windows copy step did not run inside a shared slot"
grep -q "^server-w.invalid winlock --exclusive --card lan-proof-$live_run_id -- ~/lan-proof-live/lan-proof-remote --run $live_run_id hold-server " "$live/windows.log" ||
    say "the Windows server was not started by hold-server under the exclusive lock, named for its run"
grep -q "^server-w.invalid ~/lan-proof-live/lan-proof-remote --run $live_run_id build $fake_commit" "$live/windows.log" ||
    say "a remote step did not name the run"

if [ "$fail" -ne 0 ]; then
    echo "lan-proof-selftest: failed" >&2
    exit 1
fi
echo "lan-proof-selftest: ok"
