#!/usr/bin/env bash
# channel-seed-sweep: run functional channel cases over a range of simulator
# seeds and report every seed that fails.
#
#   scripts/channel-seed-sweep --cases a,b --seeds 1-1000 [--timeout 120] [--jobs N] [--bin ./bin/functional]
#   scripts/channel-seed-sweep --all --seeds 1-2000
#   scripts/channel-seed-sweep --regressions tests/functional/channel_seed_regressions.tsv
#
# Each run is one process: ROCKETNET_CHANNEL_SEED=<seed> <bin> --run test_<case>
# (tests/functional/channel_harness.h reads the variable once at create). Lanes run
# in parallel, never more than the machine's cores. One line per failure:
#
#   FAIL seed=<n> case=<name> reason=<what>
#
# and a last line `sweep: <runs> runs, <failures> failures`. Exit 0 only with
# zero failures and every planned run made (runs = cases x seeds, or the pairs
# of --regressions); a green run whose case did not take its seed is a failure
# (reason=seed_not_taken). A failing seed replays with
#   ROCKETNET_CHANNEL_SEED=<n> ./bin/functional --run test_<case>
# --all takes every case defined in tests/functional/channel_*.cpp.
# --regressions takes the named (case, seed) pairs of a file instead of a
# product of cases and seeds: one pair per line, tab-separated case and seed
# and then a note; blank lines and lines starting with # are skipped.

set -u

here=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
root=$( cd "$here/.." && pwd )

cases=""
all=0
seeds=""
regressions=""
timeout_seconds=120
jobs=""
bin="$root/bin/functional"

usage()
{
    echo "usage: channel-seed-sweep ((--cases a,b | --all) --seeds FIRST-LAST | --regressions FILE) [--timeout SECONDS] [--jobs N] [--bin PATH]" >&2
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        --cases)   [ $# -ge 2 ] || usage; cases="$2"; shift 2 ;;
        --all)     all=1; shift ;;
        --seeds)   [ $# -ge 2 ] || usage; seeds="$2"; shift 2 ;;
        --regressions) [ $# -ge 2 ] || usage; regressions="$2"; shift 2 ;;
        --timeout) [ $# -ge 2 ] || usage; timeout_seconds="$2"; shift 2 ;;
        --jobs)    [ $# -ge 2 ] || usage; jobs="$2"; shift 2 ;;
        --bin)     [ $# -ge 2 ] || usage; bin="$2"; shift 2 ;;
        *)         usage ;;
    esac
done

if [ "$all" = 1 ]; then
    # each function by the name the functional registry gives it (most are
    # test_<function>; config_mismatch_over_loopback is
    # test_loopback_transport_config_mismatch). An unregistered function keeps
    # test_<function>, which the binary refuses, so it fails visibly.
    cases=$( for function in $( grep -h -o -E '^void [A-Za-z0-9_]+\(\)' "$root"/tests/functional/channel_*.cpp | sed -e 's/^void //' -e 's/()$//' ); do
                 name=$( grep -h -o -E "\{ \"test_[A-Za-z0-9_]+\", $function," "$root"/tests/functional/rocketnet_functional_tests.cpp | head -n 1 | sed -E 's/^\{ "([^"]+)".*/\1/' )
                 echo "${name:-test_$function}"
             done | paste -sd, - )
fi
if [ -n "$regressions" ]; then
    [ -z "$cases" ] && [ -z "$seeds" ] || usage
    [ -r "$regressions" ] || { echo "channel-seed-sweep: $regressions is not readable" >&2; exit 2; }
    pairs=$( grep -v -E '^[[:space:]]*(#|$)' "$regressions" | cut -f 1,2 | tr '\t' ' ' )
    [ -n "$pairs" ] || { echo "channel-seed-sweep: $regressions names no (case, seed) pair" >&2; exit 2; }
    if printf '%s\n' "$pairs" | grep -q -v -E '^test_[A-Za-z0-9_]+ [0-9]+$'; then
        echo "channel-seed-sweep: $regressions has a line that is not <case><tab><seed>" >&2
        exit 2
    fi
else
    [ -n "$cases" ] || usage
    [ -n "$seeds" ] || usage
    case "$seeds" in
        *-*) first=${seeds%-*}; last=${seeds#*-} ;;
        *)   first=$seeds; last=$seeds ;;
    esac
    case "$first$last" in *[!0-9]*|"") usage ;; esac
    [ "$first" -le "$last" ] || usage
fi
case "$timeout_seconds" in *[!0-9]*|"") usage ;; esac
[ -x "$bin" ] || { echo "channel-seed-sweep: $bin is not built" >&2; exit 2; }

cores=$( nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1 )
if [ -z "$jobs" ] || [ "$jobs" -gt "$cores" ]; then jobs=$cores; fi
case "$jobs" in *[!0-9]*|0) usage ;; esac

if [ "${ROCKETNET_NIGHTLY_NO_TIMEOUT:-}" = 1 ]; then
    timeout_seconds=0 # GNU timeout 0 disables its execution timer.
fi
export SWEEP_BIN="$bin" SWEEP_TIMEOUT="$timeout_seconds"

# Each lane is its own short bash process; it is dispatched by xargs with the
# case and seed as $1 and $2. Exported shell functions do not reach a child
# bash on this platform, so the run logic lives inline here, not in a function.
# Every lane appends one newline to $RUNS_FILE (the run count comes from
# executions actually attempted) and prints a "FAIL ..." line only on failure.
#
# A green run counts only when the case took the seed it was given: each lane
# names a file in ROCKETNET_CHANNEL_SEED_RECORD, the harness appends the seed
# of every create to it (tests/functional/channel_harness.h), and a run whose
# file does not hold its seed is a failure, reason=seed_not_taken. Without
# this, a case that never reaches create, or a binary that ignores the
# variable, passes every seed on the one pinned link.
report=$( mktemp )
runs_file=$( mktemp )
records=$( mktemp -d )
export RUNS_FILE="$runs_file" SWEEP_RECORDS="$records"
trap 'rm -f "$report" "$runs_file"; rm -rf "$records"' EXIT

# the runs the sweep plans: every (case, seed) pair, each run exactly once
if [ -n "$regressions" ]; then
    planned=$( printf '%s\n' "$pairs" | grep -c '' )
else
    IFS=, read -r -a planned_cases <<< "$cases"
    planned=$(( ${#planned_cases[@]} * ( last - first + 1 ) ))
fi

{
    if [ -n "$regressions" ]; then
        printf '%s\n' "$pairs"
    else
        IFS=, read -r -a case_list <<< "$cases"
        for c in "${case_list[@]}"; do
            seed=$first
            while [ "$seed" -le "$last" ]; do
                printf '%s %s\n' "$c" "$seed"
                seed=$(( seed + 1 ))
            done
        done
    fi
} | xargs -P "$jobs" -L 1 bash -c '
set -u
bin="$SWEEP_BIN"; timeout="$SWEEP_TIMEOUT"; runs_file="$RUNS_FILE"
case_name=${1:-}; seed=${2:-}
record=$( mktemp "$SWEEP_RECORDS/run.XXXXXX" ) || { printf "FAIL seed=%s case=%s reason=no_record_file\n" "$seed" "$case_name"; exit 0; }
# the functional binary registers each case as test_<function>; a name given with
# the prefix runs unchanged. The run and its measurement line use that name.
registered="test_${case_name#test_}"
out=$( ROCKETNET_CHANNEL_SEED=$seed ROCKETNET_CHANNEL_SEED_RECORD=$record timeout "$timeout" "$bin" --run "$registered" 2>&1 )
status=$?
printf "\n" >> "$runs_file"
if [ $status -eq 0 ]; then
    grep -q -x -F "$seed" "$record" && exit 0
    printf "FAIL seed=%s case=%s reason=seed_not_taken\n" "$seed" "$case_name"
    exit 0
fi
if [ $status -eq 124 ]; then
    reason="timeout_${timeout}s"
else
    # the measurement line names the shape (budget_multiple, incomplete, ...)
    reason=$( printf "%s\n" "$out" | sed -n -E "s/^${registered}: ([a-z_]+) .*/\1/p" | head -1 )
    if [ -z "$reason" ]; then
        reason=$( printf "%s\n" "$out" | sed -n -E -e "s/^check failed: \( (.*) \), function .*/\1/p" -e "s/^[a-z ]+ failed at line [0-9]+: (.*)/\1/p" | head -1 )
    fi
    [ -n "$reason" ] || reason="exit_${status}"
fi
printf "FAIL seed=%s case=%s reason=%s\n" "$seed" "$case_name" "$reason"
' _ > "$report"

runs=$(( $( wc -l < "$runs_file" ) ))
failures=$( grep -c '^FAIL ' "$report" )
# fields split on single blanks: field 2 is "seed=<n>", so its number starts at char 6
sort -t " " -k3,3 -k2.6,2n "$report"
echo "sweep: $runs runs, $failures failures"
if [ "$runs" -ne "$planned" ]; then
    echo "sweep: $runs runs of $planned planned (cases x seeds); a lane did not run"
    exit 1
fi
[ "$failures" -eq 0 ]
