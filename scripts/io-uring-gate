#!/usr/bin/env bash
#
# io-uring-gate <label>: may this Linux machine run its io_uring cells?
#
#   exit 0, silent   the kernel offers io_uring (/proc/sys/kernel/io_uring_disabled is 0, or
#                    absent on a kernel older than the switch): run the cells.
#   exit 3           it does not, and this machine is listed in tools/io_uring_absent_runners.txt
#                    with a reason; prints "<label> [SKIPPED io_uring absent on <name>: <reason>]".
#   exit 1           it does not and the machine is not listed; prints "<label> FAIL ...".
#                    io_uring missing on one of our own Linux runners is a fleet fault, never a
#                    reason to pass (the per-commit gate already fails a Linux runner whose
#                    io_uring functional rows skip: ci.yml, "io_uring functional rows skipped").
#
# The machine is $RUNNER_NAME on a runner, else the host name. Callers: nightly-soak.yml (soak,
# the LOAD io_uring cell) and scripts/transport-cells-repeat (the io_uring cells).
#
# Test seams (tools/test_transport_cells_repeat.sh): ROCKETNET_IO_URING_DISABLED_FILE is read in
# place of the kernel switch, and ROCKETNET_IO_URING_ABSENT_RUNNERS in place of the list.
set -euo pipefail
label=${1:?usage: io-uring-gate <label>}
root=$(cd "$(dirname "$0")/.." && pwd)
disabled=$(cat /proc/sys/kernel/io_uring_disabled 2>/dev/null || echo 0)
if [ -n "${ROCKETNET_IO_URING_DISABLED_FILE:-}" ]; then disabled=$(cat "$ROCKETNET_IO_URING_DISABLED_FILE" 2>/dev/null || echo 0); fi
absent_list=${ROCKETNET_IO_URING_ABSENT_RUNNERS:-$root/tools/io_uring_absent_runners.txt}
if [ "$disabled" = 0 ]; then
    exit 0
fi
name=${RUNNER_NAME:-$(hostname)}
reason=$(awk -F'\t' -v n="$name" '!/^#/ && $1 == n { print $2; exit }' "$absent_list")
if [ -n "$reason" ]; then
    echo "$label [SKIPPED io_uring absent on $name: $reason]"
    exit 3
fi
echo "$label FAIL this kernel disables io_uring (io_uring_disabled=$disabled) on $name, which is not listed in tools/io_uring_absent_runners.txt: io_uring missing on a fleet runner is a fleet fault"
exit 1
