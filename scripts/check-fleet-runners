#!/usr/bin/env python3
"""Fleet-runner lint for rocketnet CI.

Reads every workflow under .github/workflows and:
  * refuses any `runs-on:` value, matrix os/runner value, or expression branch
    that resolves to a GitHub-hosted label (ubuntu-*, macos-*, windows-*);
  * refuses any `run:` command that installs software onto the runner:
    a package manager's install verb in any spelling (sudo, env and VAR=value
    words, flags between the tool and the verb, quoted or chained commands:
    apt-get, apt, dnf, yum, zypper, apk add, pacman -S, pip/pip3/python -m
    pip, brew, cargo, go, gem, snap, choco, winget, port, npm -g/--global,
    dotnet tool install -g, luarocks install without --tree), and a
    downloaded script piped into a shell;
  * refuses an unguarded `uses: actions/setup-*` step (it installs a toolchain).

A workflow+job pair is exempt when the job is listed in
scripts/fleet-runners-exceptions.txt with one of:
  TEMPORARY  naming the card that removes the entry (nightly workflows today)
  DISABLED   the job carries `if: false` and a `# DISABLED:` comment
  GUEST      an install inside a VM the job boots: exempts the install rule
             only, never a hosted label, and a GUEST row whose job has no
             install the rule sees is stale and refused

The last line printed counts the install commands seen and how many were
guarded or exempt, so a rule that sees nothing is visible.

A `run:` step guarded by `if: runner.environment == 'github-hosted'` is
allowed: it never runs on the fleet. This mirrors the rule that guarded
actions/setup-* steps may stay.

Exits non-zero (naming file:line, workflow and job) on any refusal.
"""

import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
WF_DIR = os.environ.get("ROCKETNET_WF_DIR") or os.path.normpath(os.path.join(HERE, "..", ".github", "workflows"))
EXC_FILE = os.environ.get("ROCKETNET_EXC_FILE") or os.path.join(HERE, "fleet-runners-exceptions.txt")

# ubuntu-2404 and ubuntu-2604 are the fleet's own distro labels; no hosted
# ubuntu label is four bare digits (ubuntu-24.04, ubuntu-latest, ubuntu-slim).
HOSTED = re.compile(r"^(?:macos-|windows-|ubuntu-(?![0-9]{4}$))")

# package manager -> the verbs that install onto the machine
INSTALL_VERBS = {
    "apt-get": ("install", "build-dep"),
    "apt": ("install",),
    "aptitude": ("install",),
    "dnf": ("install", "groupinstall"),
    "yum": ("install", "groupinstall"),
    "zypper": ("install", "in"),
    "apk": ("add",),
    "brew": ("install", "reinstall", "bundle"),
    "cargo": ("install",),
    "go": ("install",),
    "gem": ("install",),
    "snap": ("install",),
    "choco": ("install",),
    "winget": ("install",),
    "port": ("install",),
    "pip": ("install",),
    "pip3": ("install",),
    "pipx": ("install",),
}
# words that run the next word as the command
PREFIX_WORDS = ("sudo", "env", "command", "exec", "nice", "time", "nohup", "doas")
PIPE_TO_SHELL = re.compile(r"\b(?:curl|wget)\b[^|]*\|\s*(?:sudo\s+(?:-\S+\s+)*)?(?:ba|z|da)?sh\b")
SETUP_ACTION = re.compile(r"^\s*actions/setup-[\w-]+")

GUARDED_OK = re.compile(r"runner\.environment.*github-hosted|github-hosted.*runner\.environment")


class JobInfo(object):
    def __init__(self, name):
        self.name = name
        self.runs_on_line = None
        self.runs_on_raw = None
        self.if_false = False
        self.disabled_comment = False
        self.include_rows = []
        self.scalar_os = []
        self.scalar_runner = []
        self.steps = []  # [run_line, guard, run_text, uses]


def split_top_level(text):
    out = []
    depth = 0
    inq = None
    cur = ""
    for ch in text:
        if inq:
            cur += ch
            if ch == inq:
                inq = None
            continue
        if ch in ("'", '"'):
            inq = ch
            cur += ch
            continue
        if ch == "[":
            depth += 1
        if ch == "]":
            depth -= 1
        if ch == "," and depth == 0:
            out.append(cur)
            cur = ""
            continue
        cur += ch
    out.append(cur)
    return out


def parse_label_list(text):
    text = text.strip()
    if text.startswith("["):
        inner = text[1:-1]
        parts = re.split(r",", inner)
        return [p.strip().strip('"').strip("'") for p in parts if p.strip()]
    return [text.strip('"').strip("'")]


def extract_matrix_paths(text):
    """Return the YAML path of a matrix include row, for line reporting."""
    m = re.search(r"\bos\s*:\s*([^\s,]+)", text)
    if m:
        return m.group(1).strip('"').strip("'")
    return ""


def resolve_runs_on(raw, row):
    raw = (raw or "").strip()
    if not raw:
        return []
    if raw.startswith("${{") and raw.endswith("}}"):
        expr = raw[3:-2].strip()
        m = re.match(r"^matrix\.runner\s*&&\s*fromJSON\(matrix\.runner\)\s*\|\|\s*matrix\.os$", expr)
        if m:
            runner = (row.get("runner") or "").strip()
            if runner and runner not in ('""', "''"):
                return parse_label_list(runner)
            return [row.get("os") or ""]
        m = re.match(r"^matrix\.os\s*==\s*'([^']+)'\s*&&\s*fromJSON\('(\[[^\]]*\])'\)\s*\|\|\s*matrix\.os$", expr)
        if m:
            target = m.group(1)
            osv = row.get("os") or ""
            if osv == target:
                return parse_label_list(m.group(2))
            return [osv]
        m = re.match(r"^matrix\.os$", expr)
        if m:
            return [row.get("os") or ""]
        if row.get("os") or row.get("runner"):
            osv = row.get("os") or ""
            runner = (row.get("runner") or "").strip()
            if runner and runner not in ('""', "''"):
                return parse_label_list(runner)
            return [osv] if osv else []
        return []
    return parse_label_list(raw)


def matrix_rows(job):
    rows = []
    if job.include_rows:
        rows = list(job.include_rows)
    else:
        os_list = job.scalar_os or [""]
        runner_list = job.scalar_runner or [""]
        for o in os_list:
            for r in runner_list:
                rows.append({"os": o, "runner": r})
    if not rows:
        rows = [{"os": "", "runner": ""}]
    return rows


def parse_workflow(lines):
    jobs = []
    job = None
    top = None
    in_strategy = False
    in_matrix = False
    in_include = False
    cur_row = None
    cur_step = None
    run_collect = None
    run_indent = None

    def flush():
        # the job's last step and last include row end where the job does
        if job is not None:
            if cur_step is not None and (cur_step[2].strip() or cur_step[3]):
                job.steps.append(cur_step)
            if cur_row is not None:
                job.include_rows.append(cur_row)

    for lineno, raw in enumerate(lines, 1):
        line = raw.rstrip("\n")
        stripped = line.strip()
        indent = len(line) - len(line.lstrip())

        if not stripped:
            continue
        if stripped.startswith("#"):
            if job is not None and "DISABLED:" in stripped:
                job.disabled_comment = True
            continue

        if indent == 0:
            m = re.match(r"^([A-Za-z_][\w-]*):", stripped)
            if m:
                top = m.group(1)
            if top != "jobs":
                flush()
                job = None
                cur_step = None
                cur_row = None
            continue

        if top == "jobs" and indent == 2:
            m = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", stripped)
            if m and not stripped.startswith("-"):
                flush()
                job = JobInfo(m.group(1))
                jobs.append(job)
                in_strategy = in_matrix = in_include = False
                cur_row = None
                cur_step = None
                continue
            if job is None:
                continue

        if job is None:
            continue

        if indent == 2:
            continue

        if indent >= 4 and stripped.startswith("runs-on:"):
            job.runs_on_line = lineno
            job.runs_on_raw = stripped[len("runs-on:"):].strip()
            cur_step = None
            continue

        if indent == 4 and stripped == "if: false":
            job.if_false = True
            continue

        if "DISABLED:" in stripped:
            job.disabled_comment = True

        if indent == 4 and stripped == "strategy:":
            in_strategy = True
            in_matrix = False
            cur_step = None
            continue
        if in_strategy and indent == 6 and stripped == "matrix:":
            in_matrix = True
            in_include = False
            cur_row = None
            cur_step = None
            continue
        if in_matrix and indent == 8 and stripped.startswith("include:"):
            in_include = True
            cur_row = None
            continue
        if in_matrix and in_include and indent >= 10:
            if stripped.startswith("- "):
                if cur_row is not None:
                    job.include_rows.append(cur_row)
                cur_row = {}
                body = stripped[2:].strip()
                body = re.split(r"\s+#", body, maxsplit=1)[0].strip()
                if body.startswith("{") and body.endswith("}"):
                    inner = body[1:-1]
                    for kv in split_top_level(inner):
                        km = re.match(r"^([\w]+)\s*:\s*(.*)$", kv.strip())
                        if km:
                            key, val = km.group(1), km.group(2).strip()
                            val = val.strip('"').strip("'")
                            cur_row[key] = val
                else:
                    km = re.match(r"^([\w]+)\s*:\s*(.*)$", body)
                    if km:
                        cur_row[km.group(1)] = km.group(2).strip('"').strip("'")
                continue
            else:
                km = re.match(r"^([\w]+)\s*:\s*(.*)$", stripped)
                if km and cur_row is not None:
                    cur_row[km.group(1)] = km.group(2).strip('"').strip("'")
                continue
        if in_matrix and not in_include and indent == 8:
            km = re.match(r"^([\w]+)\s*:\s*(\[.*\])$", stripped)
            if km:
                key = km.group(1)
                if key in ("os", "runner"):
                    for item in parse_label_list(km.group(2)):
                        getattr(job, "scalar_" + key).append(item)
                continue
            if stripped in ("os:", "runner:"):
                pass
            continue
        if in_matrix and not in_include and indent == 10:
            km = re.match(r"^-\s*([\w]+)\s*:\s*(.*)$", stripped)
            if km:
                key = km.group(1)
                if key in ("os", "runner"):
                    getattr(job, "scalar_" + key).append(km.group(2).strip('"').strip("'"))
                continue
            km2 = re.match(r"^([\w]+):\s*(.*)$", stripped)
            if km2 and km2.group(1) in ("os", "runner"):
                getattr(job, "scalar_" + km2.group(1)).append(km2.group(2).strip('"').strip("'"))
            continue

        if indent == 4 and stripped == "steps:":
            in_strategy = False
            in_matrix = False
            cur_step = None
            continue

        if indent == 6 and (stripped.startswith("- ") or stripped.startswith('-')):
            if cur_step is not None and (cur_step[2].strip() or cur_step[3]):
                job.steps.append(cur_step)
            cur_step = None
            run_collect = None
            if "run:" in stripped or stripped.startswith("- run:") or ": run:" in stripped:
                rm = re.search(r"\brun:\s*(.*)$", stripped)
                if rm is not None:
                    body = rm.group(1).strip()
                    guard = ""
                    cur_step = [lineno, guard, "", ""]
                    if body and body not in ("|", ">"):
                        cur_step[2] = body
                    else:
                        run_collect = "|" if body == "|" else ">"
                        run_indent = indent
                else:
                    cur_step = [lineno, "", "", ""]
                    run_collect = None
            else:
                cur_step = [lineno, "", "", ""]
                um = re.search(r"\buses:\s*(\S+)", stripped)
                if um is not None:
                    cur_step[3] = um.group(1)
            continue

        if cur_step is not None and indent > 6:
            if stripped.startswith("run:"):
                rm = re.search(r"\brun:\s*(.*)$", stripped)
                body = rm.group(1).strip()
                if body and body not in ("|", ">"):
                    cur_step[2] = body
                else:
                    run_collect = "|" if body == "|" else ">"
                    run_indent = indent
                continue
            if stripped.startswith("if:"):
                cur_step[1] = stripped[len("if:"):].strip().strip('"').strip("'")
                continue
            if stripped.startswith("uses:"):
                cur_step[3] = stripped[len("uses:"):].strip()
                continue
            if run_collect is not None and indent > run_indent:
                if run_collect == "|":
                    cur_step[2] += "\n" + line[indent:]
                else:
                    cur_step[2] += " " + line[indent:]
                continue
            continue

    flush()

    return jobs


def load_exceptions():
    exc = {}
    if not os.path.exists(EXC_FILE):
        return exc
    with open(EXC_FILE) as fh:
        for raw_line in fh:
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split(None, 3)
            if len(parts) < 3:
                continue
            wf, job, typ = parts[0], parts[1], parts[2].upper()
            exc.setdefault(wf, {})[job] = typ
    return exc


def disabled(job):
    """A DISABLED row exempts only a job that is really off: `if: false` with
    its `# DISABLED:` comment."""
    return bool(job.if_false and job.disabled_comment)


def shell_commands(run_text):
    """Split a run: body into simple commands: lines (with backslash
    continuations joined), then on ; && || | and the inside of quoted
    strings (a command handed to ssh, bash -c or a container is still a
    command), each as a list of words."""
    text = re.sub(r"\\\n", " ", run_text)
    text = re.sub(r"[\"']", " ; ", text)
    commands = []
    for line in text.split("\n"):
        line = re.split(r"(?:^|\s)#", line, maxsplit=1)[0]
        for part in re.split(r"&&|\|\||;|\||\$\(|`|\(|\)", line):
            words = part.split()
            if words:
                commands.append(words)
    return commands


def command_word(words):
    """Drop sudo/env-style prefixes, their flags and VAR=value words."""
    i = 0
    while i < len(words):
        w = words[i]
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", w):
            i += 1
            continue
        if w in PREFIX_WORDS:
            i += 1
            while i < len(words) and words[i].startswith("-"):
                # sudo -u user: the flag's value is the next word
                if words[i] in ("-u", "-g", "-C", "-D", "-U"):
                    i += 1
                i += 1
            continue
        break
    return words[i:]


def install_label(words):
    words = command_word(words)
    if not words:
        return None
    tool = os.path.basename(words[0])
    rest = words[1:]
    if re.match(r"^python[0-9.]*$", tool) and rest[:2] == ["-m", "pip"]:
        tool, rest = "pip", rest[2:]
    verbs = INSTALL_VERBS.get(tool)
    if verbs is not None:
        for w in rest:
            if w in verbs:
                return "%s %s" % (tool, w)
        return None
    if tool == "pacman" and any(re.match(r"^-S[a-z]*$", w) for w in rest):
        return "pacman -S"
    if tool == "npm" and any(w in ("i", "install", "add") for w in rest) and \
            any(w in ("-g", "--global") or w.startswith("--location=global") for w in rest):
        return "npm -g"
    if tool == "dotnet" and rest[:2] == ["tool", "install"] and any(w in ("-g", "--global") for w in rest):
        return "dotnet tool install -g"
    if tool == "luarocks" and "install" in rest and not any(w.startswith("--tree") for w in rest):
        return "luarocks install"
    return None


def install_violations(run_text):
    out = []
    for words in shell_commands(run_text):
        label = install_label(words)
        if label:
            out.append(label)
    if PIPE_TO_SHELL.search(run_text):
        out.append("downloaded script piped into a shell")
    return out


def main():
    exit_code = 0
    exc = load_exceptions()
    seen_jobs = set()
    installs_seen = 0
    installs_guarded = 0
    installs_exempt = 0
    guest_used = set()

    if not os.path.isdir(WF_DIR):
        print("no workflow directory: %s" % WF_DIR, file=sys.stderr)
        return 1

    for name in sorted(os.listdir(WF_DIR)):
        if not (name.endswith(".yml") or name.endswith(".yaml")):
            continue
        path = os.path.join(WF_DIR, name)
        with open(path) as fh:
            lines = fh.readlines()
        jobs = parse_workflow(lines)
        seen_jobs.update((name, job.name) for job in jobs)
        for job in jobs:
            wf_job = (name, job.name)
            exc_type = exc.get(name, {}).get(job.name) or exc.get(name, {}).get("*")

            if exc_type == "DISABLED" and not disabled(job):
                sys.stdout.write("%s:%d: %s / %s has a DISABLED exception but is live (no `if: false` + `# DISABLED:` "
                                 "comment); delete the row or disable the job\n"
                                 % (name, job.runs_on_line or 1, name, job.name))
                exit_code = 1

            hosted_found = []
            for row in matrix_rows(job):
                for label in resolve_runs_on(job.runs_on_raw, row):
                    if HOSTED.match(label):
                        hosted_found.append(label)
            if hosted_found:
                if exc_type == "TEMPORARY":
                    pass
                elif exc_type == "DISABLED":
                    if not disabled(job):
                        sys.stdout.write("%s:%d: %s / %s runs on hosted %s but its DISABLED row lacks `if: false` + `# DISABLED:` comment\n"
                                         % (name, job.runs_on_line or 1, name, job.name, ", ".join(sorted(set(hosted_found)))))
                        exit_code = 1
                else:
                    sys.stdout.write("%s:%d: %s / %s runs on hosted label %s; this job must run on the fleet or be DISABLED\n"
                                     % (name, job.runs_on_line or 1, name, job.name, ", ".join(sorted(set(hosted_found)))))
                    exit_code = 1

            for run_line, guard, run_text, uses in job.steps:
                guarded = bool(guard and GUARDED_OK.search(guard))
                found = install_violations(run_text)
                if uses and SETUP_ACTION.match(uses):
                    found.append("uses: %s" % uses.split("@")[0])
                for vio in found:
                    installs_seen += 1
                    if guarded:
                        installs_guarded += 1
                        continue
                    if exc_type in ("TEMPORARY", "GUEST"):
                        installs_exempt += 1
                        guest_used.add(wf_job)
                        continue
                    if exc_type == "DISABLED" and disabled(job):
                        installs_exempt += 1
                        continue
                    sys.stdout.write("%s:%d: %s / %s %s on the runner; replace with a presence check or exempt the job\n"
                                     % (name, run_line, name, job.name, vio))
                    exit_code = 1

    for wf, rows in sorted(exc.items()):
        for job_name in sorted(rows):
            if job_name != "*" and (wf, job_name) not in seen_jobs:
                sys.stdout.write("%s: exception row %s %s %s names no job in %s\n"
                                 % (os.path.basename(EXC_FILE), wf, job_name, rows[job_name], WF_DIR))
                exit_code = 1
            elif rows[job_name] == "GUEST" and job_name != "*" and (wf, job_name) not in guest_used:
                sys.stdout.write("%s: GUEST row %s %s exempts no install the rule sees; delete the row\n"
                                 % (os.path.basename(EXC_FILE), wf, job_name))
                exit_code = 1

    print("check-fleet-runners: install commands seen %d: guarded for hosted runners %d, exempt %d, refused %d"
          % (installs_seen, installs_guarded, installs_exempt, installs_seen - installs_guarded - installs_exempt))
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
