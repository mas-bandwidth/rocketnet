#!/usr/bin/env bash
# Selftest for scripts/check-fleet-runners.
#
# Plants a hosted label and an apt-get install in a temporary copy of a
# workflow and requires the script to name both; requires a clean copy to
# pass; and requires a DISABLED row to exempt only a disabled job. Exits
# non-zero if any assertion fails. Uses $TMPDIR only.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
check="$here/check-fleet-runners"

tmp="$(mktemp -d "${TMPDIR:-/tmp}/check-fleet-runners-selftest.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$tmp/clean/wf" "$tmp/dirty/wf"

# A clean workflow: fleet runner, guarded apt install, no hosted label.
cat > "$tmp/clean/wf/clean.yml" <<'EOF'
name: clean
on: [push]
jobs:
  clean:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - uses: actions/checkout@v4
      - name: Install dependencies (guarded)
        if: runner.environment == 'github-hosted'
        run: |
          sudo apt-get update
          sudo apt-get install -y cmake
      - name: Run
        run: make
  distro:
    runs-on: [self-hosted, Linux, X64, fleet, ubuntu-2404]
    steps:
      - run: make
EOF

# A dirty workflow: hosted label and an unguarded apt-get install.
cat > "$tmp/dirty/wf/dirty.yml" <<'EOF'
name: dirty
on: [push]
jobs:
  dirty:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - name: Install
        run: |
          sudo apt-get update
          sudo apt-get install -y cbmc
EOF

# Clean copy must pass.
if ROCKETNET_WF_DIR="$tmp/clean/wf" ROCKETNET_EXC_FILE="$tmp/exc" python3 "$check" > "$tmp/clean.out" 2>&1; then
  :
else
  echo "SELFTEST FAIL: clean workflow did not pass" >&2
  cat "$tmp/clean.out" >&2
  exit 1
fi

# Dirty copy must fail naming both the hosted label and the apt-get install.
if ROCKETNET_WF_DIR="$tmp/dirty/wf" ROCKETNET_EXC_FILE="$tmp/exc" python3 "$check" > "$tmp/dirty.out" 2>&1; then
  echo "SELFTEST FAIL: dirty workflow passed but must fail" >&2
  exit 1
fi

if ! grep -q "ubuntu-24.04" "$tmp/dirty.out"; then
  echo "SELFTEST FAIL: hosted label not named" >&2
  cat "$tmp/dirty.out" >&2
  exit 1
fi

if ! grep -q "apt-get install" "$tmp/dirty.out"; then
  echo "SELFTEST FAIL: apt-get install not named" >&2
  cat "$tmp/dirty.out" >&2
  exit 1
fi

# Every YAML block-scalar header opens a script the lint reads: `|-`, `>-`,
# `|+`, `|2` and a header with a comment each hide an install that must be named.
mkdir -p "$tmp/blocks/wf"
cat > "$tmp/blocks/wf/blocks.yml" <<'EOF'
name: blocks
on: [push]
jobs:
  strip:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - name: Literal strip
        run: |-
          sudo apt-get install -y cbmc
  fold:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - run: >-
          brew install
          cmake
  keep:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - name: Literal keep
        run: |+
          cargo install ripgrep
  indent:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - name: Explicit indentation
        run: |2
            pip install pyyaml
  comment:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - name: Header with a comment
        run: | # the install below
          go install example.com/tool@latest
EOF
if ROCKETNET_WF_DIR="$tmp/blocks/wf" ROCKETNET_EXC_FILE="$tmp/exc" python3 "$check" > "$tmp/blocks.out" 2>&1; then
  echo "SELFTEST FAIL: block-scalar run bodies were not read (an install passed)" >&2
  cat "$tmp/blocks.out" >&2
  exit 1
fi
for want in "blocks.yml / strip apt-get install" "blocks.yml / fold brew install" \
            "blocks.yml / keep cargo install" "blocks.yml / indent pip install" \
            "blocks.yml / comment go install"; do
  if ! grep -q "$want" "$tmp/blocks.out"; then
    echo "SELFTEST FAIL: block-scalar run body not read: $want not named" >&2
    cat "$tmp/blocks.out" >&2
    exit 1
  fi
done

# DISABLED exceptions: a row exempts only a job that carries `if: false` and
# a `# DISABLED:` comment. A live job listed DISABLED with an unguarded
# install is refused (its row and its install); the disabled job's install
# passes; a row naming no job is refused.
mkdir -p "$tmp/disabled/wf"
cat > "$tmp/disabled/wf/disabled.yml" <<'EOF'
name: disabled
on: [push]
jobs:
  live:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - name: Install
        run: sudo apt-get install -y cbmc
  off:
    # DISABLED: no runner for this platform yet
    if: false
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - name: Install
        run: sudo apt-get install -y cbmc
EOF

printf 'disabled.yml off DISABLED no runner\n' > "$tmp/exc-off"
if ROCKETNET_WF_DIR="$tmp/disabled/wf" ROCKETNET_EXC_FILE="$tmp/exc-off" python3 "$check" > "$tmp/off.out" 2>&1; then
  echo "SELFTEST FAIL: the live job's unguarded install passed" >&2
  exit 1
fi
if ! grep -q "disabled.yml / live apt-get install" "$tmp/off.out" || grep -q "/ off " "$tmp/off.out"; then
  echo "SELFTEST FAIL: the DISABLED row did not exempt exactly the disabled job" >&2
  cat "$tmp/off.out" >&2
  exit 1
fi

printf 'disabled.yml live DISABLED stale\ndisabled.yml off DISABLED no runner\n' > "$tmp/exc-live"
if ROCKETNET_WF_DIR="$tmp/disabled/wf" ROCKETNET_EXC_FILE="$tmp/exc-live" python3 "$check" > "$tmp/live.out" 2>&1; then
  echo "SELFTEST FAIL: a DISABLED row exempted a live job" >&2
  cat "$tmp/live.out" >&2
  exit 1
fi
if ! grep -q "disabled.yml / live has a DISABLED exception but is live" "$tmp/live.out" ||
   ! grep -q "disabled.yml / live apt-get install" "$tmp/live.out"; then
  echo "SELFTEST FAIL: the stale DISABLED row or the live job's install was not named" >&2
  cat "$tmp/live.out" >&2
  exit 1
fi

printf 'disabled.yml gone DISABLED removed\n' > "$tmp/exc-gone"
if ROCKETNET_WF_DIR="$tmp/clean/wf" ROCKETNET_EXC_FILE="$tmp/exc-gone" python3 "$check" > "$tmp/gone.out" 2>&1; then
  echo "SELFTEST FAIL: an exception row naming no job passed" >&2
  exit 1
fi
if ! grep -q "names no job" "$tmp/gone.out"; then
  echo "SELFTEST FAIL: an exception row naming no job was not named" >&2
  cat "$tmp/gone.out" >&2
  exit 1
fi

echo "SELFTEST PASS"
