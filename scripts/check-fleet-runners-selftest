#!/usr/bin/env bash
# Selftest for scripts/check-fleet-runners.
#
# Plants a hosted label and an apt-get install in a temporary copy of a
# workflow and requires the script to name both; requires a clean copy to
# pass; and requires a DISABLED row to exempt only a disabled job. Exits
# non-zero if any assertion fails. Uses $TMPDIR only.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
check="$here/check-fleet-runners"

tmp="$(mktemp -d "${TMPDIR:-/tmp}/check-fleet-runners-selftest.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$tmp/clean/wf" "$tmp/dirty/wf"

# A clean workflow: fleet runner, guarded apt install, no hosted label.
cat > "$tmp/clean/wf/clean.yml" <<'EOF'
name: clean
on: [push]
jobs:
  clean:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - uses: actions/checkout@v4
      - name: Install dependencies (guarded)
        if: runner.environment == 'github-hosted'
        run: |
          sudo apt-get update
          sudo apt-get install -y cmake
      - name: Run
        run: make
  distro:
    runs-on: [self-hosted, Linux, X64, fleet, ubuntu-2404]
    steps:
      - run: make
EOF

# A dirty workflow: hosted label and an unguarded apt-get install.
cat > "$tmp/dirty/wf/dirty.yml" <<'EOF'
name: dirty
on: [push]
jobs:
  dirty:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - name: Install
        run: |
          sudo apt-get update
          sudo apt-get install -y cbmc
EOF

# Clean copy must pass.
if ROCKETNET_WF_DIR="$tmp/clean/wf" ROCKETNET_EXC_FILE="$tmp/exc" python3 "$check" > "$tmp/clean.out" 2>&1; then
  :
else
  echo "SELFTEST FAIL: clean workflow did not pass" >&2
  cat "$tmp/clean.out" >&2
  exit 1
fi

# Dirty copy must fail naming both the hosted label and the apt-get install.
if ROCKETNET_WF_DIR="$tmp/dirty/wf" ROCKETNET_EXC_FILE="$tmp/exc" python3 "$check" > "$tmp/dirty.out" 2>&1; then
  echo "SELFTEST FAIL: dirty workflow passed but must fail" >&2
  exit 1
fi

if ! grep -q "ubuntu-24.04" "$tmp/dirty.out"; then
  echo "SELFTEST FAIL: hosted label not named" >&2
  cat "$tmp/dirty.out" >&2
  exit 1
fi

if ! grep -q "apt-get install" "$tmp/dirty.out"; then
  echo "SELFTEST FAIL: apt-get install not named" >&2
  cat "$tmp/dirty.out" >&2
  exit 1
fi

# DISABLED exceptions: a row exempts only a job that carries `if: false` and
# a `# DISABLED:` comment. A live job listed DISABLED with an unguarded
# install is refused (its row and its install); the disabled job's install
# passes; a row naming no job is refused.
mkdir -p "$tmp/disabled/wf"
cat > "$tmp/disabled/wf/disabled.yml" <<'EOF'
name: disabled
on: [push]
jobs:
  live:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - name: Install
        run: sudo apt-get install -y cbmc
  off:
    # DISABLED: no runner for this platform yet
    if: false
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - name: Install
        run: sudo apt-get install -y cbmc
EOF

printf 'disabled.yml off DISABLED no runner\n' > "$tmp/exc-off"
if ROCKETNET_WF_DIR="$tmp/disabled/wf" ROCKETNET_EXC_FILE="$tmp/exc-off" python3 "$check" > "$tmp/off.out" 2>&1; then
  echo "SELFTEST FAIL: the live job's unguarded install passed" >&2
  exit 1
fi
if ! grep -q "disabled.yml / live apt-get install" "$tmp/off.out" || grep -q "/ off " "$tmp/off.out"; then
  echo "SELFTEST FAIL: the DISABLED row did not exempt exactly the disabled job" >&2
  cat "$tmp/off.out" >&2
  exit 1
fi

printf 'disabled.yml live DISABLED stale\ndisabled.yml off DISABLED no runner\n' > "$tmp/exc-live"
if ROCKETNET_WF_DIR="$tmp/disabled/wf" ROCKETNET_EXC_FILE="$tmp/exc-live" python3 "$check" > "$tmp/live.out" 2>&1; then
  echo "SELFTEST FAIL: a DISABLED row exempted a live job" >&2
  cat "$tmp/live.out" >&2
  exit 1
fi
if ! grep -q "disabled.yml / live has a DISABLED exception but is live" "$tmp/live.out" ||
   ! grep -q "disabled.yml / live apt-get install" "$tmp/live.out"; then
  echo "SELFTEST FAIL: the stale DISABLED row or the live job's install was not named" >&2
  cat "$tmp/live.out" >&2
  exit 1
fi

printf 'disabled.yml gone DISABLED removed\n' > "$tmp/exc-gone"
if ROCKETNET_WF_DIR="$tmp/clean/wf" ROCKETNET_EXC_FILE="$tmp/exc-gone" python3 "$check" > "$tmp/gone.out" 2>&1; then
  echo "SELFTEST FAIL: an exception row naming no job passed" >&2
  exit 1
fi
if ! grep -q "names no job" "$tmp/gone.out"; then
  echo "SELFTEST FAIL: an exception row naming no job was not named" >&2
  cat "$tmp/gone.out" >&2
  exit 1
fi


# Every install spelling the tree uses or could use is refused on a fleet
# runner, one plant per step so each must be named: the tree's own form
# (sudo VAR=value apt-get install) first.
mkdir -p "$tmp/spell/wf"
cat > "$tmp/spell/wf/spell.yml" <<'EOF'
name: spell
on: [push]
jobs:
  spell:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - name: tree form
        run: |
          sudo DEBIAN_FRONTEND=noninteractive apt-get install -y cmake
      - name: flag before verb
        run: sudo apt-get -y install foo && make docs
      - name: apt
        run: sudo apt install -y foo
      - name: pip3
        run: pip3 install pyyaml
      - name: python -m pip
        run: python3 -m pip install --user pyyaml
      - name: piped installer
        run: curl -fsSL https://example.invalid/install.sh | sudo sh
      - name: dnf in a chain
        run: |
          set -e; sudo -E dnf -y install foo
      - name: inside ssh
        run: ssh guest 'sudo apt-get update && sudo apt-get install -y foo'
      - name: brew
        run: brew install foo
      - name: setup action
        uses: actions/setup-python@v5
      - name: continuation
        run: |
          sudo apt-get \
            install -y foo
EOF
if ROCKETNET_WF_DIR="$tmp/spell/wf" ROCKETNET_EXC_FILE="$tmp/exc" python3 "$check" > "$tmp/spell.out" 2>&1; then
  echo "SELFTEST FAIL: unguarded installs in other spellings passed" >&2
  cat "$tmp/spell.out" >&2
  exit 1
fi
for want in "spell.yml:7:" "spell.yml:10:" "spell.yml:12:" "spell.yml:14:" "spell.yml:16:" "spell.yml:18:" \
            "spell.yml:20:" "spell.yml:23:" "spell.yml:25:" "spell.yml:27:" "spell.yml:29:"; do
  if ! grep -q "^$want" "$tmp/spell.out"; then
    echo "SELFTEST FAIL: the install step at $want was not named" >&2
    cat "$tmp/spell.out" >&2
    exit 1
  fi
done
if ! grep -q "install commands seen 11: guarded for hosted runners 0, exempt 0, refused 11" "$tmp/spell.out"; then
  echo "SELFTEST FAIL: the census line does not count 11 refused installs" >&2
  cat "$tmp/spell.out" >&2
  exit 1
fi

# Commands that only mention a manager are not installs.
mkdir -p "$tmp/quiet/wf"
cat > "$tmp/quiet/wf/quiet.yml" <<'EOF'
name: quiet
on: [push]
jobs:
  quiet:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - run: go run ./tools/happy_path && go build ./...
      - run: dpkg -s cmake && apt-cache policy cmake
      - run: echo "install the tools first" && make install DESTDIR=stage
      - run: npm install
      - run: luarocks install --tree=lua_modules busted
EOF
if ! ROCKETNET_WF_DIR="$tmp/quiet/wf" ROCKETNET_EXC_FILE="$tmp/exc" python3 "$check" > "$tmp/quiet.out" 2>&1; then
  echo "SELFTEST FAIL: commands that install nothing on the runner were refused" >&2
  cat "$tmp/quiet.out" >&2
  exit 1
fi

# GUEST exempts installs only: never a hosted label; a GUEST row whose job
# installs nothing the rule sees is stale.
mkdir -p "$tmp/guest/wf"
cat > "$tmp/guest/wf/guest.yml" <<'EOF'
name: guest
on: [push]
jobs:
  vm:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - run: ssh guest 'sudo apt-get install -y foo'
  hosted:
    runs-on: ubuntu-latest
    steps:
      - run: make
  idle:
    runs-on: [self-hosted, Linux, X64, fleet]
    steps:
      - run: make
EOF
printf 'guest.yml vm GUEST in the guest\n' > "$tmp/exc-guest"
if ! ROCKETNET_WF_DIR="$tmp/guest/wf" ROCKETNET_EXC_FILE="$tmp/exc-guest" python3 "$check" > "$tmp/guest.out" 2>&1; then
  if grep -q "guest.yml / vm" "$tmp/guest.out"; then
    echo "SELFTEST FAIL: a GUEST row did not exempt its job's install" >&2
    cat "$tmp/guest.out" >&2
    exit 1
  fi
fi
printf 'guest.yml vm GUEST in the guest\nguest.yml hosted GUEST wrong\nguest.yml idle GUEST stale\n' > "$tmp/exc-guest2"
if ROCKETNET_WF_DIR="$tmp/guest/wf" ROCKETNET_EXC_FILE="$tmp/exc-guest2" python3 "$check" > "$tmp/guest2.out" 2>&1; then
  echo "SELFTEST FAIL: a GUEST row exempted a hosted label or a stale GUEST row passed" >&2
  cat "$tmp/guest2.out" >&2
  exit 1
fi
if ! grep -q "guest.yml / hosted runs on hosted label ubuntu-latest" "$tmp/guest2.out" ||
   ! grep -q "GUEST row guest.yml idle exempts no install" "$tmp/guest2.out" ||
   grep -q "guest.yml / vm" "$tmp/guest2.out"; then
  echo "SELFTEST FAIL: GUEST rows were not judged as expected" >&2
  cat "$tmp/guest2.out" >&2
  exit 1
fi
echo "SELFTEST PASS"
